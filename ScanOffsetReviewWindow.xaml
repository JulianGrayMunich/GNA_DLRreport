<Window x:Class="GNA_DLRreport.ScanOffsetReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stored railhead scan offsets" Width="1000" Height="540" MinWidth="780" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="txtSummary" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <DataGrid x:Name="gridOffsets" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Railhead point" Binding="{Binding PointId}" Width="150"/>
                <DataGridTextColumn Header="ToR height (m)" Binding="{Binding ReferenceHeight, StringFormat=F4}" Width="105"/>
                <DataGridTextColumn Header="ScanOffset (m)" Binding="{Binding ScanOffset, StringFormat=F6, TargetNullValue=—}" Width="115"/>
                <DataGridTextColumn Header="Points used" Binding="{Binding ScanPointCount}" Width="85"/>
                <DataGridTextColumn Header="SE (m)" Binding="{Binding StandardError, StringFormat=F6, TargetNullValue=—}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" Content="Close" Width="90" Height="28" HorizontalAlignment="Right" Margin="0,10,0,0" IsCancel="True"/>
    </Grid>
</Window>
