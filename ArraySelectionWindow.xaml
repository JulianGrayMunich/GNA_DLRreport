<Window x:Class="GNA_DLRreport.ArraySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Committed Arrays"
        Height="360"
        Width="560"
        Background="LightGray"
        FontFamily="Arial"
        FontSize="12"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- #region ARRAY SELECTION WINDOW -->

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- #region ACTIVE PROJECT -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Project:"/>

            <TextBox x:Name="txtProjectName"
                     Grid.Column="1"
                     Height="28"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"/>

        </Grid>

        <!-- #endregion -->


        <!-- #region COMMITTED ARRAYS DATAGRID -->

        <DataGrid x:Name="dgCommittedArrays"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="LightGray"
                  SelectionChanged="dgCommittedArrays_SelectionChanged"
                  MouseDoubleClick="dgCommittedArrays_MouseDoubleClick">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Array ID"
                                    Width="80"
                                    Binding="{Binding Array_ID}"/>

                <DataGridTextColumn Header="Type"
                                    Width="170"
                                    Binding="{Binding ArrayTypeName}"/>

                <DataGridTextColumn Header="Array Name"
                                    Width="*"
                                    Binding="{Binding ArrayName}"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- #endregion -->


        <!-- #region ARRAY SELECTION ACTIONS -->

        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnCancel"
                    Grid.Column="0"
                    Height="30"
                    Content="Cancel"
                    Click="btnCancel_Click"/>

            <Button x:Name="btnViewSelectedArray"
                    Grid.Column="2"
                    Height="30"
                    Content="View Array"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="btnViewSelectedArray_Click"/>

        </Grid>

        <!-- #endregion -->

    </Grid>

    <!-- #endregion -->

</Window>
