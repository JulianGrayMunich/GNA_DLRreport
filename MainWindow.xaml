<Window x:Class="GNA_DLRreport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GNA_DLRreport"
        mc:Ignorable="d"
        Title="DLR Report"
        Height="590"
        Width="960"
        Background="LightGray"
        FontFamily="Arial"
        FontSize="12"
        ResizeMode="NoResize"
        Cursor="Arrow"
        WindowStartupLocation="CenterScreen">

    <!-- #region MAIN WINDOW LAYOUT -->

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>


        <!-- #region TABBED APPLICATION AREA -->

        <Grid Grid.Row="0">

            <TabControl>


                <!-- #region REPORT GENERATION TAB -->

                <TabItem Header="Report Generation">

                    <Grid Margin="20">

                        <!-- #region REPORT GENERATION BUTTONS -->

                        <StackPanel Width="220"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- #region REPORT SCHEDULER BUTTON -->

                            <Button x:Name="btnReportScheduler"
                                    Height="35"
                                    Margin="0,0,0,12"
                                    Content="Report Scheduler"/>

                            <!-- #endregion -->


                            <!-- #region REPORT GENERATION BUTTON -->

                            <Button x:Name="btnReportGeneration"
                                    Height="35"
                                    Content="Report Generation"/>

                            <!-- #endregion -->

                        </StackPanel>

                        <!-- #endregion -->

                    </Grid>

                </TabItem>

                <!-- #endregion -->


                <!-- #region HOUSEKEEPING TAB -->

                <TabItem Header="Housekeeping">

                    <Grid Margin="20">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- #region DATABASE CONNECTION -->

                        <GroupBox Grid.Row="0"
                                  Header="Database Connection"
                                  Padding="15">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>


                                <!-- #region CONNECTION STRING -->

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Connection string:"/>

                                <TextBox x:Name="txtDbConnectionString"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Height="52"
                                         FontSize="10"
                                         VerticalContentAlignment="Center"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"/>

                                <!-- #endregion -->


                                <!-- #region TEST DATABASE CONNECTION -->

                                <Button x:Name="btnTestDbConnection"
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Height="28"
                                        Content="Test Connection"
                                        Click="btnTestDbConnection_Click"/>

                                <TextBlock x:Name="txtDbConnectionStatus"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="3"
                                           VerticalAlignment="Center"
                                           Text=""/>

                                <!-- #endregion -->

                            </Grid>

                        </GroupBox>

                        <!-- #endregion -->


                        <!-- #region DATABASE HOUSEKEEPING -->

                        <GroupBox Grid.Row="2"
                                  Header="Database Housekeeping"
                                  Padding="15">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- #region CREATE DATABASE -->

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Create database:"/>

                                <Button x:Name="btnCreateDb"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="150"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        Content="Create DB"
                                        Click="btnCreateDb_Click"/>

                                <!-- #endregion -->


                                <!-- #region CLEAR LATEST READING -->

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Clear latest reading:"/>

                                <ComboBox x:Name="cmbClearLatestReading"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Height="28"
                                          SelectedIndex="0"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="Select table..."/>

                                    <ComboBoxItem Content="CoordinatesDaily"/>

                                    <ComboBoxItem Content="DhEpochs"/>
                                    <ComboBoxItem Content="DhDaily"/>

                                    <ComboBoxItem Content="SlewEpochs"/>
                                    <ComboBoxItem Content="SlewDaily"/>

                                    <ComboBoxItem Content="TopEpochs"/>
                                    <ComboBoxItem Content="TopDaily"/>

                                    <ComboBoxItem Content="CantEpochs"/>
                                    <ComboBoxItem Content="CantDaily"/>

                                    <ComboBoxItem Content="ShortTwistEpochs"/>
                                    <ComboBoxItem Content="ShortTwistDaily"/>

                                    <ComboBoxItem Content="LongTwistEpochs"/>
                                    <ComboBoxItem Content="LongTwistDaily"/>

                                    <ComboBoxItem Content="All Epoch Tables"/>
                                    <ComboBoxItem Content="All Daily Tables"/>
                                    <ComboBoxItem Content="All Time-Series Tables"/>

                                </ComboBox>

                                <Button x:Name="btnClearLatestReading"
                                        Grid.Row="4"
                                        Grid.Column="3"
                                        Height="30"
                                        Content="Clear Latest Reading"/>

                                <!-- #endregion -->

                            </Grid>

                        </GroupBox>

                        <!-- #endregion -->

                    </Grid>

                </TabItem>

                <!-- #endregion -->


                <!-- #region CONFIGURATION TAB -->

                <TabItem Header="Configuration">

                    <Grid Margin="20">

                        <!-- #region CONFIGURATION TAB LAYOUT -->

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- #endregion -->


                        <!-- #region PROJECT CONFIGURATION SUMMARY -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>


                            <!-- #region PROJECT SELECTION FRAME -->

                            <GroupBox Grid.Column="0"
                                      Header="Project Selection"
                                      Padding="15">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- #region ACTIVE PROJECT DISPLAY -->

                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="Active project:"/>

                                    <TextBox x:Name="txtActiveProject"
                                             Grid.Column="1"
                                             Height="28"
                                             IsReadOnly="True"
                                             VerticalContentAlignment="Center"
                                             Text="No active project"/>

                                    <!-- #endregion -->


                                    <!-- #region MANAGE PROJECTS BUTTON -->

                                    <Button x:Name="btnManageProjects"
                                            Grid.Column="3"
                                            Width="150"
                                            Height="30"
                                            Content="Manage Projects"
                                            Click="btnManageProjects_Click"/>

                                    <!-- #endregion -->

                                </Grid>

                            </GroupBox>

                            <!-- #endregion -->


                            <!-- #region VIEW ARRAY BUTTON -->

                            <Button x:Name="btnViewPrismArray"
                                    Grid.Column="2"
                                    Width="120"
                                    Height="30"
                                    Margin="0,0,0,15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Content="View Array"
                                    Visibility="Collapsed"
                                    IsEnabled="False"
                                    Click="btnViewPrismArray_Click"/>

                            <!-- #endregion -->

                        </Grid>

                        <!-- #endregion -->


                        <!-- #region COORDINATE IMPORT WORKFLOWS -->

                        <TabControl x:Name="tabConfiguration"
                                    Grid.Row="2"
                                    IsEnabled="False"
                                    SelectionChanged="tabConfiguration_SelectionChanged">

                            <!-- #region REFERENCE COORDINATES TAB -->

                            <TabItem x:Name="tabReferenceCoordinates"
                                     Header="Reference Coordinates"
                                     IsEnabled="False">

                                <GroupBox Header="Point Names / Reference Coordinates Import"
                                          Margin="8"
                                          Padding="15">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <!-- #region CSV FILE SELECTION -->

                                        <Grid Grid.Row="0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Source CSV:"/>

                                            <TextBox x:Name="txtReferenceCsvPath"
                                                     Grid.Column="1"
                                                     Height="28"
                                                     IsReadOnly="True"
                                                     VerticalContentAlignment="Center"/>

                                            <Button x:Name="btnSelectReferenceCsv"
                                                    Grid.Column="3"
                                                    Height="30"
                                                    IsEnabled="True"
                                                    Content="Select CSV"
                                                    Click="btnSelectReferenceCsv_Click"/>

                                            <Button x:Name="btnClearReferenceImport"
                                                    Grid.Column="5"
                                                    Height="30"
                                                    IsEnabled="True"
                                                    Content="Clear"
                                                    Click="btnClearReferenceImport_Click"/>

                                        </Grid>

                                        <!-- #endregion -->


                                        <!-- #region CSV COLUMN ORDER -->

                                        <Grid Grid.Row="2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="360"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Column order:"/>

                                            <ComboBox x:Name="cmbReferenceCsvColumnOrder"
                                                      Grid.Column="1"
                                                      Height="28"
                                                      SelectedIndex="0"
                                                      VerticalContentAlignment="Center"
                                                      SelectionChanged="cmbReferenceCsvColumnOrder_SelectionChanged">

                                                <ComboBoxItem Content="PointName, E, N, Ht [, ReplacementName]"/>

                                                <ComboBoxItem Content="PointName, N, E, Ht [, ReplacementName]"/>

                                            </ComboBox>

                                        </Grid>

                                        <!-- #endregion -->


                                        <!-- #region IMPORT PREVIEW DATAGRID -->

                                        <DataGrid x:Name="dgReferenceCoordinateImport"
                                                  Grid.Row="4"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  SelectionChanged="dgReferenceCoordinateImport_SelectionChanged">

                                            <DataGrid.Columns>

                                                <DataGridTextColumn Header="Row"
                                                                    Width="55"
                                                                    Binding="{Binding SourceRow}"/>

                                                <DataGridTextColumn Header="Point Name"
                                                                    Width="130"
                                                                    Binding="{Binding PointName}"/>

                                                <DataGridTextColumn Header="Replacement Name"
                                                                    Width="140"
                                                                    Binding="{Binding ReplacementName}"/>

                                                <DataGridTextColumn Header="E"
                                                                    Width="95"
                                                                    Binding="{Binding EastingText}"/>

                                                <DataGridTextColumn Header="N"
                                                                    Width="95"
                                                                    Binding="{Binding NorthingText}"/>

                                                <DataGridTextColumn Header="Ht"
                                                                    Width="85"
                                                                    Binding="{Binding HeightText}"/>

                                                <DataGridTextColumn Header="Validation"
                                                                    Width="*"
                                                                    Binding="{Binding ValidationStatus}"/>

                                            </DataGrid.Columns>

                                        </DataGrid>

                                        <!-- #endregion -->


                                        <!-- #region IMPORT STATUS AND COMMIT -->

                                        <Grid Grid.Row="6">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="txtReferenceImportStatus"
                                                     Grid.Column="0"
                                                     Height="42"
                                                     IsReadOnly="True"
                                                     TextWrapping="NoWrap"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     VerticalContentAlignment="Center"
                                                     Text="No CSV selected."/>

                                            <Button x:Name="btnCommitReferenceImport"
                                                    Grid.Column="2"
                                                    Height="30"
                                                    Content="Commit Import"
                                                    IsEnabled="False"
                                                    Click="btnCommitReferenceImport_Click"/>

                                        </Grid>

                                        <!-- #endregion -->

                                    </Grid>

                                </GroupBox>

                            </TabItem>

                            <!-- #endregion -->


                            <!-- #region PRISM PAIRS TAB -->

                            <TabItem x:Name="tabPrismPairs"
                                     Header="Prism Pairs"
                                     IsEnabled="False">

                                <GroupBox Header="Prism Pair Import"
                                          Margin="8"
                                          Padding="15">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <!-- #region TRACK GEOMETRY WORKBOOK SELECTION -->

                                        <Grid Grid.Row="0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="125"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Workbook:"/>

                                            <TextBox x:Name="txtPrismPairWorkbookPath"
                                                     Grid.Column="1"
                                                     Height="28"
                                                     IsReadOnly="True"
                                                     VerticalContentAlignment="Center"/>

                                            <Button x:Name="btnSelectPrismPairWorkbook"
                                                    Grid.Column="3"
                                                    Height="30"
                                                    IsEnabled="True"
                                                    Content="Select Workbook"
                                                    Click="btnSelectPrismPairWorkbook_Click"/>

                                            <Button x:Name="btnClearPrismPairImport"
                                                    Grid.Column="5"
                                                    Height="30"
                                                    IsEnabled="True"
                                                    Content="Clear"
                                                    Click="btnClearPrismPairImport_Click"/>

                                        </Grid>

                                        <!-- #endregion -->

                                        <!-- #region WORKSHEET SELECTION -->

                                        <Grid Grid.Row="2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="360"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Worksheet:"/>

                                            <ComboBox x:Name="cmbPrismPairWorksheet"
                                                      Grid.Column="1"
                                                      Height="28"
                                                      VerticalContentAlignment="Center"
                                                      SelectionChanged="cmbPrismPairWorksheet_SelectionChanged"/>

                                        </Grid>

                                        <!-- #endregion -->

                                        <!-- #region PRISM PAIR PREVIEW DATAGRID -->

                                        <DataGrid x:Name="dgPrismPairImport"
                                                  Grid.Row="6"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  CanUserResizeRows="False"
                                                  CanUserSortColumns="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  SelectionChanged="dgPrismPairImport_SelectionChanged">

                                            <DataGrid.Columns>

                                                <!-- #region PAIR ORDER -->

                                                <DataGridTextColumn Header="Pair Order"
                                                                    Width="85"
                                                                    Binding="{Binding PairOrder}"/>

                                                <!-- #endregion -->


                                                <!-- #region SOURCE COLUMN 1 -->

                                                <DataGridTextColumn Width="170"
                                                                    Binding="{Binding SourceColumn1Value}">

                                                    <DataGridTextColumn.Header>

                                                        <ComboBox x:Name="cmbPrismPairColumn1Role"
                                                                  Width="130"
                                                                  SelectedIndex="0"
                                                                  SelectionChanged="PrismPairColumnRole_SelectionChanged">

                                                            <ComboBoxItem Content="Right (Primary) Rail"/>
                                                            <ComboBoxItem Content="Left Rail"/>
                                                            <ComboBoxItem Content="Rail Tag"/>

                                                        </ComboBox>

                                                    </DataGridTextColumn.Header>

                                                </DataGridTextColumn>

                                                <!-- #endregion -->


                                                <!-- #region SOURCE COLUMN 2 -->

                                                <DataGridTextColumn Width="170"
                                                                    Binding="{Binding SourceColumn2Value}">

                                                    <DataGridTextColumn.Header>

                                                        <ComboBox x:Name="cmbPrismPairColumn2Role"
                                                                  Width="130"
                                                                  SelectedIndex="1"
                                                                  SelectionChanged="PrismPairColumnRole_SelectionChanged">

                                                            <ComboBoxItem Content="Right (Primary) Rail"/>
                                                            <ComboBoxItem Content="Left Rail"/>
                                                            <ComboBoxItem Content="Rail Tag"/>

                                                        </ComboBox>

                                                    </DataGridTextColumn.Header>

                                                </DataGridTextColumn>

                                                <!-- #endregion -->


                                                <!-- #region SOURCE COLUMN 3 -->

                                                <DataGridTextColumn Width="150"
                                                                    Binding="{Binding SourceColumn3Value}">

                                                    <DataGridTextColumn.Header>

                                                        <ComboBox x:Name="cmbPrismPairColumn3Role"
                                                                  Width="120"
                                                                  SelectedIndex="2"
                                                                  SelectionChanged="PrismPairColumnRole_SelectionChanged">

                                                            <ComboBoxItem Content="Right (Primary) Rail"/>
                                                            <ComboBoxItem Content="Left Rail"/>
                                                            <ComboBoxItem Content="Rail Tag"/>

                                                        </ComboBox>

                                                    </DataGridTextColumn.Header>

                                                </DataGridTextColumn>

                                                <!-- #endregion -->


                                                <!-- #region TRACK TAG -->

                                                <DataGridTextColumn Header="Track Name"
                                                                    Width="110"
                                                                    Binding="{Binding TrackName}"/>

                                                <!-- #endregion -->


                                                <!-- #region VALIDATION -->

                                                <DataGridTextColumn Header="Validation"
                                                                    Width="*"
                                                                    Binding="{Binding ValidationStatus}"/>

                                                <!-- #endregion -->

                                            </DataGrid.Columns>

                                        </DataGrid>

                                        <!-- #endregion -->

                                        <!-- #region PRISM PAIR STATUS AND COMMIT -->

                                        <Grid Grid.Row="8">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="txtPrismPairImportStatus"
                                                     Grid.Column="0"
                                                     Height="42"
                                                     IsReadOnly="True"
                                                     TextWrapping="NoWrap"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     VerticalContentAlignment="Center"
                                                     Text="No workbook selected."/>

                                            <Button x:Name="btnPreviewPrismPairs"
                                                    Grid.Column="2"
                                                    Height="30"
                                                    Content="Preview Pairs"
                                                    IsEnabled="False"
                                                    Click="btnPreviewPrismPairs_Click"/>

                                            <Button x:Name="btnCommitPrismPairImport"
                                                    Grid.Column="4"
                                                    Height="30"
                                                    Content="Commit Import"
                                                    IsEnabled="False"
                                                    Click="btnCommitPrismPairImport_Click"/>

                                        </Grid>

                                        <!-- #endregion -->


                                    </Grid>

                                </GroupBox>

                            </TabItem>

                            <!-- #endregion -->

                            <!-- #region PRISM ARRAYS TAB -->

                            <TabItem x:Name="tabPrismArrays"
                                     Header="Arrays"
                                     IsEnabled="False">

                                <GroupBox Header="Prism Array Configuration"
                                          Margin="8"
                                          Padding="12">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <!-- #region ARRAY DEFINITION HEADER -->

                                        <Grid Grid.Row="0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="185"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="85"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="105"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Array type:"/>

                                            <ComboBox x:Name="cmbPrismArrayType"
                                                      Grid.Column="1"
                                                      Height="28"
                                                      SelectedIndex="-1"
                                                      DisplayMemberPath="ArrayTypeName"
                                                      SelectedValuePath="ArrayType_ID"
                                                      SelectionChanged="cmbPrismArrayType_SelectionChanged"
                                                      VerticalContentAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                                                       VerticalAlignment="Center"
                                                       Text="Array name:"/>

                                            <TextBox x:Name="txtPrismArrayName"
                                                     Grid.Column="4"
                                                     Height="28"
                                                     MaxLength="200"
                                                     VerticalContentAlignment="Center"/>

                                            <Button x:Name="btnClearPrismArrayDefinition"
                                                    Grid.Column="6"
                                                    Height="30"
                                                    Content="Clear Definition"
                                                    Click="btnClearPrismArrayDefinition_Click"/>

                                            <Button x:Name="btnCommitPrismArray"
                                                    Grid.Column="8"
                                                    Height="30"
                                                    Content="Commit Array"
                                                    Click="btnCommitPrismArray_Click"/>

                                        </Grid>

                                        <!-- #endregion -->


                                        <!-- #region ARRAY POINT ASSIGNMENT AREA -->

                                        <Grid Grid.Row="2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1.25*"/>
                                            </Grid.ColumnDefinitions>


                                            <!-- #region AVAILABLE POINTS -->

                                            <GroupBox Grid.Column="0"
                                                      Header="Available Points"
                                                      Padding="8">

                                                <DataGrid x:Name="dgPrismArrayAvailablePoints"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          CanUserReorderColumns="False"
                                                          CanUserResizeRows="False"
                                                          CanUserSortColumns="True"
                                                          IsReadOnly="True"
                                                          SelectionMode="Single"
                                                          SelectionUnit="FullRow"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="Gainsboro">

                                                    <DataGrid.Columns>

                                                        <DataGridTextColumn Header="Replacement Name"
                                                                            Width="*"
                                                                            Binding="{Binding ReplacementName}"/>

                                                    </DataGrid.Columns>

                                                </DataGrid>

                                            </GroupBox>

                                            <!-- #endregion -->


                                            <!-- #region RIGHT-HAND ARRAY CONFIGURATION -->

                                            <Grid Grid.Column="2">

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>


                                                <!-- #region A-E ASSIGNMENTS -->

                                                <GroupBox Grid.Row="0"
                                                          Header="A-E Point Assignment"
                                                          Padding="8">

                                                    <Grid>

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="7"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="7"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="7"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="7"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="25"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="A:"/>
                                                        <TextBox x:Name="txtPrismArrayPointA" Grid.Row="0" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                                        <Button x:Name="btnAssignPrismArrayA" Grid.Row="0" Grid.Column="3" Height="28" Content="Assign A" Click="btnAssignPrismArrayA_Click"/>
                                                        <Button x:Name="btnClearPrismArrayA" Grid.Row="0" Grid.Column="5" Height="28" Content="Clear" IsEnabled="False" Click="btnClearPrismArrayA_Click"/>

                                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="B:"/>
                                                        <TextBox x:Name="txtPrismArrayPointB" Grid.Row="2" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                                        <Button x:Name="btnAssignPrismArrayB" Grid.Row="2" Grid.Column="3" Height="28" Content="Assign B" Click="btnAssignPrismArrayB_Click"/>
                                                        <Button x:Name="btnClearPrismArrayB" Grid.Row="2" Grid.Column="5" Height="28" Content="Clear" IsEnabled="False" Click="btnClearPrismArrayB_Click"/>

                                                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="C:"/>
                                                        <TextBox x:Name="txtPrismArrayPointC" Grid.Row="4" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                                        <Button x:Name="btnAssignPrismArrayC" Grid.Row="4" Grid.Column="3" Height="28" Content="Assign C" Click="btnAssignPrismArrayC_Click"/>
                                                        <Button x:Name="btnClearPrismArrayC" Grid.Row="4" Grid.Column="5" Height="28" Content="Clear" IsEnabled="False" Click="btnClearPrismArrayC_Click"/>

                                                        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="D:"/>
                                                        <TextBox x:Name="txtPrismArrayPointD" Grid.Row="6" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                                        <Button x:Name="btnAssignPrismArrayD" Grid.Row="6" Grid.Column="3" Height="28" Content="Assign D" Click="btnAssignPrismArrayD_Click"/>
                                                        <Button x:Name="btnClearPrismArrayD" Grid.Row="6" Grid.Column="5" Height="28" Content="Clear" IsEnabled="False" Click="btnClearPrismArrayD_Click"/>

                                                        <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="E:"/>
                                                        <TextBox x:Name="txtPrismArrayPointE" Grid.Row="8" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                                        <Button x:Name="btnAssignPrismArrayE" Grid.Row="8" Grid.Column="3" Height="28" Content="Assign E" Click="btnAssignPrismArrayE_Click"/>
                                                        <Button x:Name="btnClearPrismArrayE" Grid.Row="8" Grid.Column="5" Height="28" Content="Clear" IsEnabled="False" Click="btnClearPrismArrayE_Click"/>

                                                    </Grid>

                                                </GroupBox>

                                                <!-- #endregion -->
                                        <!-- #region COMMITTED ARRAYS -->

                                        <GroupBox Grid.Row="2"
                                                  Grid.Column="2"
                                                  Header="Committed Arrays"
                                                  Padding="10">

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>


                                                <!-- #region COMMITTED ARRAYS HEADER -->

                                                <TextBlock Grid.Row="0"
                                                           VerticalAlignment="Center"
                                                           Text="Select a committed array to view its definition."/>

                                                <!-- #endregion -->


                                                <!-- #region COMMITTED ARRAYS DATAGRID -->

                                                <DataGrid x:Name="dgCommittedPrismArrays"
                                                          Grid.Row="2"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          CanUserReorderColumns="False"
                                                          CanUserResizeRows="False"
                                                          IsReadOnly="True"
                                                          SelectionMode="Single"
                                                          SelectionUnit="FullRow"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="LightGray"
                                                          SelectionChanged="dgCommittedPrismArrays_SelectionChanged">

                                                    <DataGrid.Columns>

                                                        <DataGridTextColumn Header="Array ID"
                                                                            Width="75"
                                                                            Binding="{Binding Array_ID}"/>

                                                        <DataGridTextColumn Header="Type"
                                                                            Width="150"
                                                                            Binding="{Binding ArrayTypeName}"/>

                                                        <DataGridTextColumn Header="Array Name"
                                                                            Width="*"
                                                                            Binding="{Binding ArrayName}"/>

                                                    </DataGrid.Columns>

                                                </DataGrid>

                                                <!-- #endregion -->

                                            </Grid>

                                        </GroupBox>

                                        <!-- #endregion -->

                                            </Grid>

                                            <!-- #endregion -->

                                        </Grid>

                                        <!-- #endregion -->


                                        <!-- #region ARRAY STATUS -->

                                        <TextBox x:Name="txtPrismArrayStatus"
                                                 Grid.Row="4"
                                                 Height="42"
                                                 IsReadOnly="True"
                                                 TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 VerticalContentAlignment="Center"
                                                 Text="Select the Arrays tab to load available points."/>

                                        <!-- #endregion -->

                                    </Grid>

                                </GroupBox>

                            </TabItem>

                            <!-- #endregion -->


                            <!-- #region GEOTECH TAB -->

                            <TabItem x:Name="tabGeotech"
                                     Header="Geotech"
                                     IsEnabled="False">

                                <GroupBox Header="Geotechnical Sensor Import"
                                          Margin="8"
                                          Padding="15">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <!-- #region CSV FILE SELECTION -->

                                        <Grid Grid.Row="0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Source CSV:"/>

                                            <TextBox x:Name="txtGeotechCsvPath"
                                                     Grid.Column="1"
                                                     Height="28"
                                                     IsReadOnly="True"
                                                     VerticalContentAlignment="Center"/>

                                            <Button x:Name="btnSelectGeotechCsv"
                                                    Grid.Column="3"
                                                    Height="30"
                                                    Content="Select CSV"
                                                    Click="btnSelectGeotechCsv_Click"/>

                                            <Button x:Name="btnClearGeotechImport"
                                                    Grid.Column="5"
                                                    Height="30"
                                                    Content="Clear"
                                                    Click="btnClearGeotechImport_Click"/>

                                        </Grid>

                                        <!-- #endregion -->


                                        <!-- #region CSV COLUMN ORDER -->

                                        <Grid Grid.Row="2">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="500"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Column order:"/>

                                            <ComboBox x:Name="cmbGeotechCsvColumnOrder"
                                                      Grid.Column="1"
                                                      Height="28"
                                                      SelectedIndex="0"
                                                      IsEnabled="False"
                                                      VerticalContentAlignment="Center">

                                                <ComboBoxItem Content="Sensor Name, E, N, Ht, Replacement Name, Sensor Type"/>

                                            </ComboBox>

                                        </Grid>

                                        <!-- #endregion -->


                                        <!-- #region IMPORT PREVIEW DATAGRID -->

                                        <DataGrid x:Name="dgGeotechSensorImport"
                                                  Grid.Row="4"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="LightGray"
                                                  SelectionChanged="dgGeotechSensorImport_SelectionChanged">

                                            <DataGrid.Columns>

                                                <DataGridTextColumn Header="Row"
                                                                    Width="50"
                                                                    Binding="{Binding SourceRow}"/>

                                                <DataGridTextColumn Header="Sensor Name"
                                                                    Width="115"
                                                                    Binding="{Binding SensorName}"/>

                                                <DataGridTextColumn Header="Replacement Name"
                                                                    Width="125"
                                                                    Binding="{Binding ReplacementName}"/>

                                                <DataGridTextColumn Header="Sensor Type"
                                                                    Width="90"
                                                                    Binding="{Binding SensorType}"/>

                                                <DataGridTextColumn Header="E"
                                                                    Width="90"
                                                                    Binding="{Binding EastingText}"/>

                                                <DataGridTextColumn Header="N"
                                                                    Width="90"
                                                                    Binding="{Binding NorthingText}"/>

                                                <DataGridTextColumn Header="Ht"
                                                                    Width="80"
                                                                    Binding="{Binding HeightText}"/>

                                                <DataGridTextColumn Header="Validation"
                                                                    Width="*"
                                                                    Binding="{Binding ValidationStatus}"/>

                                            </DataGrid.Columns>

                                        </DataGrid>

                                        <!-- #endregion -->


                                        <!-- #region IMPORT STATUS AND COMMIT -->

                                        <Grid Grid.Row="6">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="txtGeotechImportStatus"
                                                     Grid.Column="0"
                                                     Height="42"
                                                     IsReadOnly="True"
                                                     TextWrapping="NoWrap"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     VerticalContentAlignment="Center"
                                                     Text="No CSV selected."/>

                                            <Button x:Name="btnCommitGeotechImport"
                                                    Grid.Column="2"
                                                    Height="30"
                                                    Content="Commit Import"
                                                    IsEnabled="False"
                                                    Click="btnCommitGeotechImport_Click"/>

                                        </Grid>

                                        <!-- #endregion -->

                                    </Grid>

                                </GroupBox>

                            </TabItem>

                            <!-- #endregion -->


                        </TabControl>

                        <!-- #endregion -->


                        <!-- #region PROJECT MANAGEMENT OVERLAY -->

                        <Border x:Name="brdProjectManagement"
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Margin="35"
                                Padding="20"
                                Background="WhiteSmoke"
                                BorderBrush="DarkGray"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed"
                                Panel.ZIndex="100">

                            <Grid>

                                <!-- #region PROJECT MANAGEMENT LAYOUT -->

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- #endregion -->


                                <!-- #region PROJECT MANAGEMENT HEADER -->

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="Project Management"/>

                                    <Button x:Name="btnCloseProjectManagement"
                                            Grid.Column="1"
                                            Width="80"
                                            Height="28"
                                            Content="Close"
                                            Click="btnCloseProjectManagement_Click"/>

                                </Grid>

                                <!-- #endregion -->


                                <!-- #region ADD PROJECT -->

                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="350"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="New project:"/>

                                    <TextBox x:Name="txtNewProjectName"
                                             Grid.Column="1"
                                             Height="28"
                                             MaxLength="200"
                                             VerticalContentAlignment="Center"/>

                                    <Button x:Name="btnAddProject"
                                            Grid.Column="3"
                                            Height="30"
                                            Content="Add Project"
                                            Click="btnAddProject_Click"/>

                                </Grid>

                                <!-- #endregion -->


                                <!-- #region PROJECT DATAGRID -->

                                <DataGrid x:Name="dgProjects"
                                          Grid.Row="4"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal">

                                    <DataGrid.Columns>

                                        <!-- #region HIDDEN PROJECT ID -->

                                        <DataGridTextColumn Header="Project ID"
                                                            Binding="{Binding Project_ID}"
                                                            Visibility="Collapsed"
                                                            IsReadOnly="True"/>

                                        <!-- #endregion -->


                                        <!-- #region ACTIVE PROJECT -->

                                        <DataGridTemplateColumn Header="Active"
                                                                Width="80">

                                            <DataGridTemplateColumn.CellTemplate>

                                                <DataTemplate>

                                                    <RadioButton HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 GroupName="ActiveProject"
                                                                 IsChecked="{Binding IsActive,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                 Click="ActiveProjectRadioButton_Click">

                                                        <RadioButton.Style>

                                                            <Style TargetType="RadioButton">

                                                                <Setter Property="IsEnabled"
                                                                        Value="True"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding IsDeleted}"
                                                                                 Value="True">

                                                                        <Setter Property="IsEnabled"
                                                                                Value="False"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </RadioButton.Style>

                                                    </RadioButton>

                                                </DataTemplate>

                                            </DataGridTemplateColumn.CellTemplate>

                                        </DataGridTemplateColumn>

                                        <!-- #endregion -->


                                        <!-- #region PROJECT NAME -->

                                        <DataGridTextColumn Header="Project Name"
                                                            Width="*"
                                                            Binding="{Binding ProjectName,
                                                                              Mode=TwoWay,
                                                                              UpdateSourceTrigger=LostFocus}">

                                            <DataGridTextColumn.EditingElementStyle>

                                                <Style TargetType="TextBox">

                                                    <EventSetter Event="LostFocus"
                                                                 Handler="ProjectNameTextBox_LostFocus"/>

                                                </Style>

                                            </DataGridTextColumn.EditingElementStyle>

                                        </DataGridTextColumn>

                                        <!-- #endregion -->


                                        <!-- #region DELETED PROJECT -->

                                        <DataGridTemplateColumn Header="Deleted"
                                                                Width="90">

                                            <DataGridTemplateColumn.CellTemplate>

                                                <DataTemplate>

                                                    <CheckBox HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsDeleted,
                                                                                  Mode=TwoWay,
                                                                                  UpdateSourceTrigger=PropertyChanged}"
                                                              Click="DeletedProjectCheckBox_Click">

                                                        <CheckBox.Style>

                                                            <Style TargetType="CheckBox">

                                                                <Setter Property="IsEnabled"
                                                                        Value="True"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                                 Value="True">

                                                                        <Setter Property="IsEnabled"
                                                                                Value="False"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </CheckBox.Style>

                                                    </CheckBox>

                                                </DataTemplate>

                                            </DataGridTemplateColumn.CellTemplate>

                                        </DataGridTemplateColumn>

                                        <!-- #endregion -->

                                    </DataGrid.Columns>

                                </DataGrid>

                                <!-- #endregion -->


                                <!-- #region PROJECT MANAGEMENT STATUS -->

                                <Grid Grid.Row="6">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="txtProjectManagementStatus"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="DimGray"
                                               Text="Changes are saved after validation."/>

                                </Grid>

                                <!-- #endregion -->

                            </Grid>

                        </Border>

                        <!-- #endregion -->

                    </Grid>

                </TabItem>

                <!-- #endregion -->

            </TabControl>

        </Grid>

        <!-- #endregion -->


        <!-- #region COPYRIGHT FOOTER -->

        <TextBlock x:Name="extras_tbCopyright"
                   Grid.Row="1"
                   Margin="9,0,0,4"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   TextAlignment="Left"
                   FontFamily="Century Gothic"
                   FontSize="9"
                   Foreground="DarkSlateGray"
                   Text="{Binding CopyrightText, RelativeSource={RelativeSource AncestorType=Window}}"/>

        <!-- #endregion -->

    </Grid>

    <!-- #endregion -->

</Window>
