<Window x:Class="GNA_DLRreport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GNA_DLRreport"
        mc:Ignorable="d"
        Title="DLR Report"
        Height="590"
        Width="960"
        Background="LightGray"
        FontFamily="Arial"
        FontSize="12"
        ResizeMode="NoResize"
        Cursor="Arrow"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- #region MAIN WINDOW LAYOUT -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- #region TABBED APPLICATION AREA -->

        <Grid Grid.Row="0">
            <TabControl>

                <!-- #region REPORT GENERATION TAB -->

                <TabItem Header="Report Generation">
                    <Grid Margin="20">
                        <StackPanel Width="430"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Margin="0,0,10,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="Project Start"/>
                                <DatePicker x:Name="dpReportProjectStart"
                                            Grid.Column="1"
                                            Height="28"
                                            IsEnabled="False"
                                            SelectedDateFormat="Short"
                                            VerticalContentAlignment="Center"
                                            SelectedDateChanged="dpReportProjectStart_SelectedDateChanged"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Margin="0,0,10,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="Report Start Date"/>
                                <DatePicker x:Name="dpReportStartDate"
                                            Grid.Column="1"
                                            Height="28"
                                            SelectedDateFormat="Short"
                                            VerticalContentAlignment="Center"
                                            SelectedDateChanged="dpReportStartDate_SelectedDateChanged"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Margin="0,0,10,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="Report End Date"/>
                                <DatePicker x:Name="dpReportEndDate"
                                            Grid.Column="1"
                                            Height="28"
                                            SelectedDateFormat="Short"
                                            VerticalContentAlignment="Center"
                                            SelectedDateChanged="dpReportEndDate_SelectedDateChanged"/>
                                <TextBox x:Name="txtReportDayOffset"
                                         Grid.Column="3"
                                         Height="28"
                                         MaxLength="5"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         Text="14"
                                         PreviewTextInput="txtReportDayOffset_PreviewTextInput"
                                         TextChanged="txtReportDayOffset_TextChanged"/>
                                <TextBlock Grid.Column="5"
                                           VerticalAlignment="Center"
                                           Text="Day offset"/>
                            </Grid>

                            <Button x:Name="btnReportGeneration"
                                    Height="35"
                                    Content="Report Generation"/>
                            <TextBlock x:Name="txtReportGenerationStatus"
                                       Margin="0,10,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- #endregion -->

                <!-- #region DATABASE TAB -->

                <TabItem Header="Database">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- #region DATABASE CONNECTION -->

                        <GroupBox Grid.Row="0"
                                  Header="Database Connection"
                                  Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"
                                           Text="Connection string:"/>
                                <TextBox x:Name="txtDbConnectionString"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Height="52"
                                         FontSize="10"
                                         VerticalContentAlignment="Center"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"/>
                                <Button x:Name="btnTestDbConnection"
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Height="28"
                                        Content="Test Connection"
                                        Click="btnTestDbConnection_Click"/>
                                <TextBlock x:Name="txtDbConnectionStatus"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="3"
                                           VerticalAlignment="Center"
                                           Text=""/>
                            </Grid>
                        </GroupBox>

                        <!-- #endregion -->

                        <!-- #region DATABASE HOUSEKEEPING -->

                        <GroupBox Grid.Row="2"
                                  Header="Database Housekeeping"
                                  Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Create database:"/>
                                <Button x:Name="btnCreateDb"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="150"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        Content="Create DB"
                                        ToolTip="Create or recreate DBTrackGeometry including all monitoring and chart-definition repository tables."
                                        Click="btnCreateDb_Click"/>

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Clear latest reading:"/>
                                <ComboBox x:Name="cmbClearLatestReading"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Height="28"
                                          SelectedIndex="0"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Select table..."/>
                                    <ComboBoxItem Content="CoordinatesDaily"/>
                                    <ComboBoxItem Content="DhEpochs"/>
                                    <ComboBoxItem Content="DhDaily"/>
                                    <ComboBoxItem Content="SlewEpochs"/>
                                    <ComboBoxItem Content="SlewDaily"/>
                                    <ComboBoxItem Content="TopEpochs"/>
                                    <ComboBoxItem Content="TopDaily"/>
                                    <ComboBoxItem Content="CantEpochs"/>
                                    <ComboBoxItem Content="CantDaily"/>
                                    <ComboBoxItem Content="ShortTwistEpochs"/>
                                    <ComboBoxItem Content="ShortTwistDaily"/>
                                    <ComboBoxItem Content="LongTwistEpochs"/>
                                    <ComboBoxItem Content="LongTwistDaily"/>
                                    <ComboBoxItem Content="All Epoch Tables"/>
                                    <ComboBoxItem Content="All Daily Tables"/>
                                    <ComboBoxItem Content="All Time-Series Tables"/>
                                </ComboBox>
                                <Button x:Name="btnClearLatestReading"
                                        Grid.Row="4"
                                        Grid.Column="3"
                                        Height="30"
                                        Content="Clear Latest Reading"/>
                            </Grid>
                        </GroupBox>

                        <!-- #endregion -->
                    </Grid>
                </TabItem>

                <!-- #endregion -->

                <!-- #region CONFIGURATION TAB -->

                <TabItem Header="Configuration">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- #region PROJECT CONFIGURATION SUMMARY -->

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0"
                                      Header="Project Selection"
                                      Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="Active project:"/>
                                    <TextBox x:Name="txtActiveProject"
                                             Grid.Column="1"
                                             Height="28"
                                             IsReadOnly="True"
                                             VerticalContentAlignment="Center"
                                             Text="No active project"/>
                                    <Button x:Name="btnManageProjects"
                                            Grid.Column="3"
                                            Width="150"
                                            Height="30"
                                            Content="Manage Projects"
                                            Click="btnManageProjects_Click"/>
                                </Grid>
                            </GroupBox>

                            <Button x:Name="btnViewPrismArray"
                                    Grid.Column="2"
                                    Width="120"
                                    Height="30"
                                    Margin="0,0,0,15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Content="View Array"
                                    Visibility="Collapsed"
                                    IsEnabled="False"
                                    Click="btnViewPrismArray_Click"/>
                        </Grid>

                        <!-- #endregion -->

                        <!-- #region CONFIGURATION WORKFLOWS -->

                        <TabControl x:Name="tabConfiguration"
                                    Grid.Row="2"
                                    IsEnabled="False"
                                    SelectionChanged="tabConfiguration_SelectionChanged">

                            <!-- #region REFERENCE COORDINATES TAB -->

                            <TabItem x:Name="tabReferenceCoordinates"
                                     Header="Reference Coordinates"
                                     IsEnabled="False">
                                <GroupBox Header="Point Names / Reference Coordinates Import"
                                          Margin="8"
                                          Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Source CSV:"/>
                                            <TextBox x:Name="txtReferenceCsvPath"
                                                     Grid.Column="1"
                                                     Height="28"
                                                     IsReadOnly="True"
                                                     VerticalContentAlignment="Center"/>
                                            <Button x:Name="btnSelectReferenceCsv"
                                                    Grid.Column="3"
                                                    Height="30"
                                                    Content="Select CSV"
                                                    Click="btnSelectReferenceCsv_Click"/>
                                            <Button x:Name="btnClearReferenceImport"
                                                    Grid.Column="5"
                                                    Height="30"
                                                    Content="Clear"
                                                    Click="btnClearReferenceImport_Click"/>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="360"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Column order:"/>
                                            <ComboBox x:Name="cmbReferenceCsvColumnOrder"
                                                      Grid.Column="1"
                                                      Height="28"
                                                      SelectedIndex="0"
                                                      VerticalContentAlignment="Center"
                                                      SelectionChanged="cmbReferenceCsvColumnOrder_SelectionChanged">
                                                <ComboBoxItem Content="PointName, E, N, Ht [, ReplacementName]"/>
                                                <ComboBoxItem Content="PointName, N, E, Ht [, ReplacementName]"/>
                                            </ComboBox>
                                        </Grid>

                                        <DataGrid x:Name="dgReferenceCoordinateImport"
                                                  Grid.Row="4"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  SelectionChanged="dgReferenceCoordinateImport_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Row" Width="55" Binding="{Binding SourceRow}"/>
                                                <DataGridTextColumn Header="Point Name" Width="130" Binding="{Binding PointName}"/>
                                                <DataGridTextColumn Header="Replacement Name" Width="140" Binding="{Binding ReplacementName}"/>
                                                <DataGridTextColumn Header="E" Width="95" Binding="{Binding EastingText}"/>
                                                <DataGridTextColumn Header="N" Width="95" Binding="{Binding NorthingText}"/>
                                                <DataGridTextColumn Header="Ht" Width="85" Binding="{Binding HeightText}"/>
                                                <DataGridTextColumn Header="Validation" Width="*" Binding="{Binding ValidationStatus}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtReferenceImportStatus"
                                                     Grid.Column="0"
                                                     Height="42"
                                                     IsReadOnly="True"
                                                     TextWrapping="NoWrap"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     VerticalContentAlignment="Center"
                                                     Text="No CSV selected."/>
                                            <Button x:Name="btnCommitReferenceImport"
                                                    Grid.Column="2"
                                                    Height="30"
                                                    Content="Commit Import"
                                                    IsEnabled="False"
                                                    Click="btnCommitReferenceImport_Click"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                            </TabItem>

                            <!-- #endregion -->

                            <!-- #region PRISM PAIRS TAB -->

                            <TabItem x:Name="tabPrismPairs"
                                     Header="Prism Pairs"
                                     IsEnabled="False">
                                <GroupBox Header="Prism Pair Import"
                                          Margin="8"
                                          Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="125"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Workbook:"/>
                                            <TextBox x:Name="txtPrismPairWorkbookPath"
                                                     Grid.Column="1"
                                                     Height="28"
                                                     IsReadOnly="True"
                                                     VerticalContentAlignment="Center"/>
                                            <Button x:Name="btnSelectPrismPairWorkbook"
                                                    Grid.Column="3"
                                                    Height="30"
                                                    Content="Select Workbook"
                                                    Click="btnSelectPrismPairWorkbook_Click"/>
                                            <Button x:Name="btnClearPrismPairImport"
                                                    Grid.Column="5"
                                                    Height="30"
                                                    Content="Clear"
                                                    Click="btnClearPrismPairImport_Click"/>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="360"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Worksheet:"/>
                                            <ComboBox x:Name="cmbPrismPairWorksheet"
                                                      Grid.Column="1"
                                                      Height="28"
                                                      VerticalContentAlignment="Center"
                                                      SelectionChanged="cmbPrismPairWorksheet_SelectionChanged"/>
                                        </Grid>

                                        <DataGrid x:Name="dgPrismPairImport"
                                                  Grid.Row="6"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  CanUserResizeRows="False"
                                                  CanUserSortColumns="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  SelectionChanged="dgPrismPairImport_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Pair Order" Width="85" Binding="{Binding PairOrder}"/>

                                                <DataGridTextColumn Width="170" Binding="{Binding SourceColumn1Value}">
                                                    <DataGridTextColumn.Header>
                                                        <ComboBox x:Name="cmbPrismPairColumn1Role"
                                                                  Width="130"
                                                                  SelectedIndex="0"
                                                                  SelectionChanged="PrismPairColumnRole_SelectionChanged">
                                                            <ComboBoxItem Content="Right (Primary) Rail"/>
                                                            <ComboBoxItem Content="Left Rail"/>
                                                            <ComboBoxItem Content="Rail Tag"/>
                                                        </ComboBox>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="170" Binding="{Binding SourceColumn2Value}">
                                                    <DataGridTextColumn.Header>
                                                        <ComboBox x:Name="cmbPrismPairColumn2Role"
                                                                  Width="130"
                                                                  SelectedIndex="1"
                                                                  SelectionChanged="PrismPairColumnRole_SelectionChanged">
                                                            <ComboBoxItem Content="Right (Primary) Rail"/>
                                                            <ComboBoxItem Content="Left Rail"/>
                                                            <ComboBoxItem Content="Rail Tag"/>
                                                        </ComboBox>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Width="150" Binding="{Binding SourceColumn3Value}">
                                                    <DataGridTextColumn.Header>
                                                        <ComboBox x:Name="cmbPrismPairColumn3Role"
                                                                  Width="120"
                                                                  SelectedIndex="2"
                                                                  SelectionChanged="PrismPairColumnRole_SelectionChanged">
                                                            <ComboBoxItem Content="Right (Primary) Rail"/>
                                                            <ComboBoxItem Content="Left Rail"/>
                                                            <ComboBoxItem Content="Rail Tag"/>
                                                        </ComboBox>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="Track Name" Width="110" Binding="{Binding TrackName}"/>
                                                <DataGridTextColumn Header="Validation" Width="*" Binding="{Binding ValidationStatus}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid Grid.Row="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtPrismPairImportStatus"
                                                     Grid.Column="0"
                                                     Height="42"
                                                     IsReadOnly="True"
                                                     TextWrapping="NoWrap"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     VerticalContentAlignment="Center"
                                                     Text="No workbook selected."/>
                                            <Button x:Name="btnPreviewPrismPairs"
                                                    Grid.Column="2"
                                                    Height="30"
                                                    Content="Preview Pairs"
                                                    IsEnabled="False"
                                                    Click="btnPreviewPrismPairs_Click"/>
                                            <Button x:Name="btnCommitPrismPairImport"
                                                    Grid.Column="4"
                                                    Height="30"
                                                    Content="Commit Import"
                                                    IsEnabled="False"
                                                    Click="btnCommitPrismPairImport_Click"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                            </TabItem>

                            <!-- #endregion -->

                            <!-- #region PRISM ARRAYS TAB -->

                            <TabItem x:Name="tabPrismArrays"
                                     Header="Arrays"
                                     IsEnabled="False">
                                <GroupBox Header="Prism Array Configuration"
                                          Margin="8"
                                          Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="185"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="85"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="105"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Array type:"/>
                                            <ComboBox x:Name="cmbPrismArrayType"
                                                      Grid.Column="1"
                                                      Height="28"
                                                      SelectedIndex="-1"
                                                      DisplayMemberPath="ArrayTypeName"
                                                      SelectedValuePath="ArrayType_ID"
                                                      SelectionChanged="cmbPrismArrayType_SelectionChanged"
                                                      VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       VerticalAlignment="Center"
                                                       Text="Array name:"/>
                                            <TextBox x:Name="txtPrismArrayName"
                                                     Grid.Column="4"
                                                     Height="28"
                                                     MaxLength="200"
                                                     VerticalContentAlignment="Center"/>
                                            <Button x:Name="btnClearPrismArrayDefinition"
                                                    Grid.Column="6"
                                                    Height="30"
                                                    Content="Clear Definition"
                                                    Click="btnClearPrismArrayDefinition_Click"/>
                                            <Button x:Name="btnCommitPrismArray"
                                                    Grid.Column="8"
                                                    Height="30"
                                                    Content="Commit Array"
                                                    Click="btnCommitPrismArray_Click"/>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1.25*"/>
                                            </Grid.ColumnDefinitions>

                                            <GroupBox Grid.Column="0"
                                                      Header="Available Points"
                                                      Padding="8">
                                                <DataGrid x:Name="dgPrismArrayAvailablePoints"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          CanUserReorderColumns="False"
                                                          CanUserResizeRows="False"
                                                          CanUserSortColumns="True"
                                                          IsReadOnly="True"
                                                          SelectionMode="Single"
                                                          SelectionUnit="FullRow"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="Gainsboro">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Replacement Name" Width="*" Binding="{Binding ReplacementName}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </GroupBox>

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <GroupBox Grid.Row="0"
                                                          Header="A-E Point Assignment"
                                                          Padding="8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="7"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="7"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="7"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="7"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="25"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="A:"/>
                                                        <TextBox x:Name="txtPrismArrayPointA" Grid.Row="0" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                                        <Button x:Name="btnAssignPrismArrayA" Grid.Row="0" Grid.Column="3" Height="28" Content="Assign A" Click="btnAssignPrismArrayA_Click"/>
                                                        <Button x:Name="btnClearPrismArrayA" Grid.Row="0" Grid.Column="5" Height="28" Content="Clear" IsEnabled="False" Click="btnClearPrismArrayA_Click"/>

                                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="B:"/>
                                                        <TextBox x:Name="txtPrismArrayPointB" Grid.Row="2" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                                        <Button x:Name="btnAssignPrismArrayB" Grid.Row="2" Grid.Column="3" Height="28" Content="Assign B" Click="btnAssignPrismArrayB_Click"/>
                                                        <Button x:Name="btnClearPrismArrayB" Grid.Row="2" Grid.Column="5" Height="28" Content="Clear" IsEnabled="False" Click="btnClearPrismArrayB_Click"/>

                                                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="C:"/>
                                                        <TextBox x:Name="txtPrismArrayPointC" Grid.Row="4" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                                        <Button x:Name="btnAssignPrismArrayC" Grid.Row="4" Grid.Column="3" Height="28" Content="Assign C" Click="btnAssignPrismArrayC_Click"/>
                                                        <Button x:Name="btnClearPrismArrayC" Grid.Row="4" Grid.Column="5" Height="28" Content="Clear" IsEnabled="False" Click="btnClearPrismArrayC_Click"/>

                                                        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="D:"/>
                                                        <TextBox x:Name="txtPrismArrayPointD" Grid.Row="6" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                                        <Button x:Name="btnAssignPrismArrayD" Grid.Row="6" Grid.Column="3" Height="28" Content="Assign D" Click="btnAssignPrismArrayD_Click"/>
                                                        <Button x:Name="btnClearPrismArrayD" Grid.Row="6" Grid.Column="5" Height="28" Content="Clear" IsEnabled="False" Click="btnClearPrismArrayD_Click"/>

                                                        <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="E:"/>
                                                        <TextBox x:Name="txtPrismArrayPointE" Grid.Row="8" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                                        <Button x:Name="btnAssignPrismArrayE" Grid.Row="8" Grid.Column="3" Height="28" Content="Assign E" Click="btnAssignPrismArrayE_Click"/>
                                                        <Button x:Name="btnClearPrismArrayE" Grid.Row="8" Grid.Column="5" Height="28" Content="Clear" IsEnabled="False" Click="btnClearPrismArrayE_Click"/>
                                                    </Grid>
                                                </GroupBox>

                                                <GroupBox Grid.Row="2"
                                                          Header="Committed Arrays"
                                                          Padding="10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0"
                                                                   VerticalAlignment="Center"
                                                                   Text="Select a committed array to view its definition."/>
                                                        <DataGrid x:Name="dgCommittedPrismArrays"
                                                                  Grid.Row="2"
                                                                  AutoGenerateColumns="False"
                                                                  CanUserAddRows="False"
                                                                  CanUserDeleteRows="False"
                                                                  CanUserReorderColumns="False"
                                                                  CanUserResizeRows="False"
                                                                  IsReadOnly="False"
                                                                  SelectionMode="Single"
                                                                  SelectionUnit="FullRow"
                                                                  HeadersVisibility="Column"
                                                                  GridLinesVisibility="Horizontal"
                                                                  HorizontalGridLinesBrush="LightGray"
                                                                  SelectionChanged="dgCommittedPrismArrays_SelectionChanged">
                                                            <DataGrid.Columns>
                                                                <DataGridCheckBoxColumn Header="Included" Width="75" Binding="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                    <DataGridCheckBoxColumn.ElementStyle>
                                                                        <Style TargetType="CheckBox">
                                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                            <EventSetter Event="Click" Handler="PrismArrayIncludedCheckBox_Click"/>
                                                                        </Style>
                                                                    </DataGridCheckBoxColumn.ElementStyle>
                                                                </DataGridCheckBoxColumn>
                                                                <DataGridTextColumn Header="Array ID" Width="75" IsReadOnly="True" Binding="{Binding Array_ID}"/>
                                                                <DataGridTextColumn Header="Type" Width="150" IsReadOnly="True" Binding="{Binding ArrayTypeName}"/>
                                                                <DataGridTextColumn Header="Array Name" Width="*" IsReadOnly="True" Binding="{Binding ArrayName}"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </Grid>
                                                </GroupBox>
                                            </Grid>
                                        </Grid>

                                        <TextBox x:Name="txtPrismArrayStatus"
                                                 Grid.Row="4"
                                                 Height="42"
                                                 IsReadOnly="True"
                                                 TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 VerticalContentAlignment="Center"
                                                 Text="Select the Arrays tab to load available points."/>
                                    </Grid>
                                </GroupBox>
                            </TabItem>

                            <!-- #endregion -->

                            <!-- #region GEOTECH TAB -->

                            <TabItem x:Name="tabGeotech"
                                     Header="Geotech"
                                     IsEnabled="False">
                                <GroupBox Header="Geotechnical Sensor Import"
                                          Margin="8"
                                          Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Source CSV:"/>
                                            <TextBox x:Name="txtGeotechCsvPath"
                                                     Grid.Column="1"
                                                     Height="28"
                                                     IsReadOnly="True"
                                                     VerticalContentAlignment="Center"/>
                                            <Button x:Name="btnSelectGeotechCsv"
                                                    Grid.Column="3"
                                                    Height="30"
                                                    Content="Select CSV"
                                                    Click="btnSelectGeotechCsv_Click"/>
                                            <Button x:Name="btnClearGeotechImport"
                                                    Grid.Column="5"
                                                    Height="30"
                                                    Content="Clear"
                                                    Click="btnClearGeotechImport_Click"/>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="500"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="Column order:"/>
                                            <ComboBox x:Name="cmbGeotechCsvColumnOrder"
                                                      Grid.Column="1"
                                                      Height="28"
                                                      SelectedIndex="0"
                                                      IsEnabled="False"
                                                      VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="Sensor Name, E, N, Ht, Replacement Name, Sensor Type"/>
                                            </ComboBox>
                                        </Grid>

                                        <DataGrid x:Name="dgGeotechSensorImport"
                                                  Grid.Row="4"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserReorderColumns="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="LightGray"
                                                  SelectionChanged="dgGeotechSensorImport_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Row" Width="50" Binding="{Binding SourceRow}"/>
                                                <DataGridTextColumn Header="Sensor Name" Width="115" Binding="{Binding SensorName}"/>
                                                <DataGridTextColumn Header="Replacement Name" Width="125" Binding="{Binding ReplacementName}"/>
                                                <DataGridTextColumn Header="Sensor Type" Width="90" Binding="{Binding SensorType}"/>
                                                <DataGridTextColumn Header="E" Width="90" Binding="{Binding EastingText}"/>
                                                <DataGridTextColumn Header="N" Width="90" Binding="{Binding NorthingText}"/>
                                                <DataGridTextColumn Header="Ht" Width="80" Binding="{Binding HeightText}"/>
                                                <DataGridTextColumn Header="Validation" Width="*" Binding="{Binding ValidationStatus}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtGeotechImportStatus"
                                                     Grid.Column="0"
                                                     Height="42"
                                                     IsReadOnly="True"
                                                     TextWrapping="NoWrap"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Disabled"
                                                     VerticalContentAlignment="Center"
                                                     Text="No CSV selected."/>
                                            <Button x:Name="btnCommitGeotechImport"
                                                    Grid.Column="2"
                                                    Height="30"
                                                    Content="Commit Import"
                                                    IsEnabled="False"
                                                    Click="btnCommitGeotechImport_Click"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                            </TabItem>

                            <!-- #endregion -->
                        </TabControl>

                        <!-- #endregion -->

                        <!-- #region PROJECT MANAGEMENT OVERLAY -->

                        <Border x:Name="brdProjectManagement"
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Margin="35"
                                Padding="20"
                                Background="WhiteSmoke"
                                BorderBrush="DarkGray"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed"
                                Panel.ZIndex="100">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="Project Management"/>
                                    <Button x:Name="btnCloseProjectManagement"
                                            Grid.Column="1"
                                            Width="80"
                                            Height="28"
                                            Content="Close"
                                            Click="btnCloseProjectManagement_Click"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="New project:"/>
                                    <TextBox x:Name="txtNewProjectName" Grid.Row="0"
                                             Grid.Column="1"
                                             Height="28"
                                             MaxLength="200"
                                             VerticalContentAlignment="Center"
                                             TextChanged="ProjectRequiredField_Changed"/>
                                    <DatePicker x:Name="dpProjectStartDate" Grid.Row="0"
                                                Grid.Column="3"
                                                Height="28"
                                                SelectedDateFormat="Short"
                                                VerticalContentAlignment="Center"
                                                SelectedDateChanged="ProjectRequiredField_Changed"
                                                CalendarClosed="dpProjectStartDate_CalendarClosed"/>
                                    <Button x:Name="btnProjectStartCalendar" Grid.Row="0"
                                            Grid.Column="5"
                                            Height="30"
                                            Content="Project Start"
                                            Click="btnProjectStartCalendar_Click"/>
                                    <Button x:Name="btnAddProject" Grid.Row="0"
                                            Grid.Column="7"
                                            Width="117"
                                            Height="30"
                                            IsEnabled="False"
                                            Content="Add Project"
                                            Click="btnAddProject_Click"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Project time zone:"/>
                                    <ComboBox x:Name="cmbProjectTimeZone" Grid.Row="2" Grid.Column="1" Height="28" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="ProjectRequiredField_Changed"/>
                                    <Button x:Name="btnSelectProjectOutputPath" Grid.Row="2" Grid.Column="3" Height="30" Content="Output Path..." Click="btnSelectProjectOutputPath_Click"/>
                                    <TextBox x:Name="txtProjectOutputPath" Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="4" Width="199" Height="28" HorizontalAlignment="Left" MaxLength="1000" IsReadOnly="True" VerticalContentAlignment="Center" TextChanged="ProjectRequiredField_Changed"/>
                                    <Button x:Name="btnSaveProjectSettings" Grid.Row="2" Grid.Column="8" Width="110" Height="30" Margin="8,0,0,0" HorizontalAlignment="Left" Content="Save Settings" Click="btnSaveProjectSettings_Click"/>
                                </Grid>

                                <DataGrid x:Name="dgProjects"
                                          Grid.Row="4"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          SelectionChanged="dgProjects_SelectionChanged"
                                          MaxHeight="420">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Project ID"
                                                            Binding="{Binding Project_ID}"
                                                            Visibility="Collapsed"
                                                            IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Active" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <RadioButton HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 GroupName="ActiveProject"
                                                                 IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Click="ActiveProjectRadioButton_Click">
                                                        <RadioButton.Style>
                                                            <Style TargetType="RadioButton">
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </RadioButton.Style>
                                                    </RadioButton>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Project Name"
                                                            Width="*"
                                                            Binding="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <EventSetter Event="LostFocus" Handler="ProjectNameTextBox_LostFocus"/>
                                                </Style>
                                            </DataGridTextColumn.EditingElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Project Start Date"
                                                                Width="145"
                                                                IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Loaded="ProjectStartDateTextBlock_Loaded"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Deleted" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsDeleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Click="DeletedProjectCheckBox_Click">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtProjectManagementStatus"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="DimGray"
                                               Text="Changes are saved after validation."/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- #endregion -->
                    </Grid>
                </TabItem>

                <!-- #endregion -->

                <!-- #region CHARTS TAB -->

                <TabItem x:Name="tabCharts"
                         Header="Charts"
                         IsEnabled="False">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- #region CHART MANAGEMENT -->

                        <GroupBox Grid.Row="0"
                                  Header="Chart Management"
                                  Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="245"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txtChartReportDateInformation"
                                           Grid.Row="0"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="5"
                                           VerticalAlignment="Center"
                                           Foreground="DimGray"
                                           Text="Report Start: —    Report End: —"/>
                                <ComboBox x:Name="cmbChartTemplate"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Visibility="Collapsed"
                                          Height="28"
                                          DisplayMemberPath="DisplayText"/>
                                <Button x:Name="btnLoadChartTemplate"
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Visibility="Collapsed"
                                        Height="30"
                                        Content="Load Template"
                                        Click="btnLoadChartTemplate_Click"/>
                                <StackPanel Grid.Row="2"
                                            Grid.Column="4"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal">
                                    <Button x:Name="btnChartPreviewTemplate"
                                            Width="120"
                                            Height="30"
                                            Visibility="Collapsed"
                                            Content="Preview Template"
                                            Click="btnChartPreviewTemplate_Click"/>
                                    <Button x:Name="btnChartPreviewChart"
                                            Width="110"
                                            Height="30"
                                            Margin="0,0,0,0"
                                            IsEnabled="False"
                                            Content="Preview Chart"
                                            Click="btnChartPreviewChart_Click"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Margin="0,0,8,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="Existing charts:"/>
                                <ComboBox x:Name="cmbExistingChart"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          Height="28"
                                          DisplayMemberPath="DisplayText"
                                          SelectionChanged="cmbExistingChart_SelectionChanged"/>
                                <Button x:Name="btnChartLoad"
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Height="30"
                                        Content="Load Chart"
                                        Click="btnChartLoad_Click"/>

                                <WrapPanel Grid.Row="4"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="4"
                                           HorizontalAlignment="Left">
                                    <Button x:Name="btnChartNew"
                                            Width="82"
                                            Height="30"
                                            Content="New chart"
                                            Click="btnChartNew_Click"/>
                                    <Button x:Name="btnChartCopy"
                                            Width="70"
                                            Height="30"
                                            Margin="6,0,0,0"
                                            Content="Copy"
                                            Click="btnChartCopy_Click"/>
                                    <Button x:Name="btnChartDelete"
                                            Width="70"
                                            Height="30"
                                            Margin="6,0,0,0"
                                            Content="Delete"
                                            Click="btnChartDelete_Click"/>
                                    <Button x:Name="btnSaveChartTemplate"
                                            Width="105"
                                            Height="30"
                                            Margin="6,0,0,0"
                                            Visibility="Collapsed"
                                            Content="Save Template"
                                            Click="btnSaveChartTemplate_Click"/>
                                    <Button x:Name="btnChartCommit"
                                            Width="90"
                                            Height="30"
                                            Margin="6,0,0,0"
                                            Content="Save Chart"
                                            Click="btnChartCommit_Click"/>
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <!-- #endregion -->

                        <!-- #region CHART CONFIGURATION TABS -->

                        <TabControl x:Name="tabChartConfiguration"
                                    Grid.Row="2">

                            <!-- #region DEFINITION -->

                            <TabItem Header="Definition">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="360"/>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Chart number:"/>
                                    <TextBox x:Name="txtChartNumber" Grid.Row="0" Grid.Column="1" Width="120" Height="28" HorizontalAlignment="Left" IsReadOnly="True" VerticalContentAlignment="Center" Text="New"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Chart name:"/>
                                    <TextBox x:Name="txtChartName" Grid.Row="2" Grid.Column="1" Height="28" MaxLength="200" VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Chart type:"/>
                                    <ComboBox x:Name="cmbChartType" Grid.Row="4" Grid.Column="1" Height="28" DisplayMemberPath="DisplayName" SelectionChanged="cmbChartType_SelectionChanged"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Source:"/>
                                    <TextBox x:Name="txtChartDataSource" Grid.Row="6" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Row="6" Grid.Column="3" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Unit:"/>
                                    <TextBox x:Name="txtChartUnit" Grid.Row="6" Grid.Column="4" Width="112" Height="28" HorizontalAlignment="Left" IsReadOnly="True" VerticalContentAlignment="Center"/>

                                </Grid>
                            </TabItem>

                            <!-- #endregion -->

                            <!-- #region SERIES -->

                            <TabItem Header="Series">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Entity:"/>
                                        <ComboBox x:Name="cmbChartSeriesEntity"
                                                  Grid.Column="1"
                                                  Height="28"
                                                  IsEditable="False"
                                                  IsTextSearchEnabled="True"/>
                                        <TextBlock Grid.Column="3" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Data element:"/>
                                        <ComboBox x:Name="cmbChartDataElement"
                                                  Grid.Column="4"
                                                  Height="28"
                                                  SelectionChanged="cmbChartDataElement_SelectionChanged"/>
                                    </Grid>

                                    <DataGrid x:Name="dgChartSeries"
                                              Grid.Row="2"
                                              RowHeight="30"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              HeadersVisibility="Column">
                                        <DataGrid.Resources>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                            <Style TargetType="{x:Type TextBox}">
                                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.CellStyle>
                                            <Style TargetType="{x:Type DataGridCell}">
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGrid.CellStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Order" Width="70" Binding="{Binding DisplayOrder}"/>
                                            <DataGridTextColumn Header="Entity" Width="220" Binding="{Binding EntityDisplayName}"/>
                                            <DataGridTextColumn Header="Data Element" Width="180" Binding="{Binding DataElementDisplayName}"/>
                                            <DataGridTextColumn Header="Legend" Width="*" Binding="{Binding LegendText}"/>
                                            <DataGridTemplateColumn Header="Colour" Width="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox Height="26"
                                                                  ItemsSource="{Binding ChartSeriesColourOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding ColourHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Border Width="18"
                                                                                Height="18"
                                                                                Margin="2,0,8,0"
                                                                                Background="{Binding}"
                                                                                BorderBrush="Black"
                                                                                BorderThickness="1"/>
                                                                        <TextBlock VerticalAlignment="Center" Text="{Binding}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Line" Width="80" Binding="{Binding LineWidth}"/>
                                            <DataGridTextColumn Header="Marker" Width="80" Binding="{Binding MarkerSize}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="btnChartAddSeries" Width="100" Height="30" Content="Add Series" Click="btnChartAddSeries_Click"/>
                                        <Button x:Name="btnChartRemoveSeries" Width="110" Height="30" Margin="8,0,0,0" Content="Remove Series" Click="btnChartRemoveSeries_Click"/>
                                        <Button x:Name="btnChartClearSeries" Width="100" Height="30" Margin="8,0,0,0" Content="Clear Series" Click="btnChartClearSeries_Click"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <!-- #endregion -->

                            <!-- #region TIME AND REFERENCE -->

                            <TabItem Header="Time Basis">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <GroupBox Grid.Row="0" Header="Report-Resolved Time Basis" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="15"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="15"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Start date basis:"/>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                                                    <RadioButton x:Name="rbChartReportStart" GroupName="ChartStartDateBasis" Content="Report Start" IsChecked="True" Checked="ChartStartDateBasis_Checked"/>
                                                    <RadioButton x:Name="rbChartProjectStart" Margin="24,0,0,0" GroupName="ChartStartDateBasis" Content="Project Start" Checked="ChartStartDateBasis_Checked"/>
                                                </StackPanel>

                                                <!-- Legacy date controls are retained only to preserve binary compatibility during schema migration. -->
                                                <StackPanel Visibility="Collapsed">
                                                    <TextBox x:Name="txtChartStartDateBasis" Text="Report Start"/>
                                                    <ComboBox x:Name="cmbChartStartDateMode" SelectionChanged="cmbChartStartDateMode_SelectionChanged">
                                                        <ComboBoxItem Content="Report Start" Tag="ReportStart" IsSelected="True"/>
                                                        <ComboBoxItem Content="Project Start" Tag="ProjectStart"/>
                                                    </ComboBox>
                                                    <TextBox x:Name="txtChartProjectTimeZone" Text="Not configured"/>
                                                    <DatePicker x:Name="dpChartStartDate" SelectedDateFormat="Short"/>
                                                    <DatePicker x:Name="dpChartEndDate" SelectedDateFormat="Short"/>
                                                    <TextBox x:Name="txtChartRecentDays" Text="14"/>
                                                    <Button x:Name="btnChartProjectStart" Click="btnChartProjectStart_Click"/>
                                                    <Button x:Name="btnChartUseNow" Click="btnChartUseNow_Click"/>
                                                    <Button x:Name="btnChartRecentPeriod" Click="btnChartRecentPeriod_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- #endregion -->

                            <!-- #region TRIGGER BANDS -->

                            <TabItem Header="Trigger Bands">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Green trigger:"/>
                                    <TextBox x:Name="txtChartGreenTrigger" Grid.Row="0" Grid.Column="1" Height="28" TextAlignment="Center" VerticalContentAlignment="Center" Text="2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Amber trigger:"/>
                                    <TextBox x:Name="txtChartAmberTrigger" Grid.Row="2" Grid.Column="1" Height="28" TextAlignment="Center" VerticalContentAlignment="Center" Text="4"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Red trigger:"/>
                                    <TextBox x:Name="txtChartRedTrigger" Grid.Row="4" Grid.Column="1" Height="28" TextAlignment="Center" VerticalContentAlignment="Center" Text="6" LostFocus="txtChartRedTrigger_LostFocus"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Current unit:"/>
                                    <TextBox x:Name="txtChartTriggerUnit" Grid.Row="6" Grid.Column="1" Width="90" Height="28" HorizontalAlignment="Left" IsReadOnly="True" TextAlignment="Center" VerticalContentAlignment="Center"/>

                                    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4">
                                        <TextBlock Foreground="DimGray" Text="Bands are mirrored about zero:"/>
                                        <TextBlock Margin="28,3,0,0" Foreground="DimGray" Text="Light Green from 0 to ±Green"/>
                                        <TextBlock Margin="28,2,0,0" Foreground="DimGray" Text="Light Yellow from ±Green to ±Amber"/>
                                        <TextBlock Margin="28,2,0,0" Foreground="DimGray" Text="Light Red from ±Amber to ±Red"/>
                                        <TextBlock Margin="28,2,0,0" Foreground="DimGray" Text="Light Grey from ±Red to the Vertical Axis limits"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <!-- #endregion -->

                            <!-- #region AXES AND TITLES -->

                            <TabItem Header="Axes &amp; Titles">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <GroupBox Grid.Row="0" Header="Vertical Axis" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="25"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox x:Name="chkChartAutomaticYAxis"
                                                          Grid.Row="0"
                                                          Grid.Column="0"
                                                          Grid.ColumnSpan="2"
                                                          Content="Automatic Vertical Axis"
                                                          IsChecked="True"
                                                          Checked="chkChartAutomaticYAxis_Changed"
                                                          Unchecked="chkChartAutomaticYAxis_Changed"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Minimum:"/>
                                                <TextBox x:Name="txtChartYAxisMinimum" Grid.Row="2" Grid.Column="1" Height="28" IsEnabled="False" Tag="SignedDecimal" PreviewTextInput="NumericTextBox_PreviewTextInput" DataObject.Pasting="NumericTextBox_Pasting" VerticalContentAlignment="Center"/>
                                                <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Maximum:"/>
                                                <TextBox x:Name="txtChartYAxisMaximum" Grid.Row="2" Grid.Column="4" Height="28" IsEnabled="False" Tag="SignedDecimal" PreviewTextInput="NumericTextBox_PreviewTextInput" DataObject.Pasting="NumericTextBox_Pasting" VerticalContentAlignment="Center"/>
                                            </Grid>
                                        </GroupBox>

                                        <GroupBox Grid.Row="2" Header="Titles and Legend" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Chart Title:"/>
                                                <TextBox x:Name="txtChartTitleOverride" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Vertical Axis:"/>
                                                <TextBox x:Name="txtChartYAxisTitle" Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>

                                                <CheckBox x:Name="chkChartShowLegend" Grid.Row="0" Grid.Column="3" Content="Show Legend" IsChecked="True"/>
                                                <ComboBox x:Name="cmbChartLegendPosition" Grid.Row="0" Grid.Column="4" Height="28" SelectedIndex="0">
                                                    <ComboBoxItem Content="Below Title"/>
                                                    <ComboBoxItem Content="Below Chart"/>
                                                    <ComboBoxItem Content="Right of Chart"/>
                                                    <ComboBoxItem Content="Left of Chart"/>
                                                </ComboBox>

                                                <TextBlock Grid.Row="4"
                                                           Grid.Column="0"
                                                           Grid.ColumnSpan="5"
                                                           Foreground="DimGray"
                                                           Text="Horizontal Axis: Date / Time. Display time is fixed to Local Time."/>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- #endregion -->

                            <!-- #region APPEARANCE -->

                            <TabItem Header="Appearance">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Width (mm):"/>
                                    <TextBox x:Name="txtChartWidthMm" Grid.Row="0" Grid.Column="1" Height="28" Tag="PositiveInteger" PreviewTextInput="NumericTextBox_PreviewTextInput" DataObject.Pasting="NumericTextBox_Pasting" VerticalContentAlignment="Center" Text="150" TextChanged="ChartPhysicalSize_Changed"/>

                                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Height (mm):"/>
                                    <TextBox x:Name="txtChartHeightMm" Grid.Row="0" Grid.Column="4" Height="28" Tag="PositiveInteger" PreviewTextInput="NumericTextBox_PreviewTextInput" DataObject.Pasting="NumericTextBox_Pasting" VerticalContentAlignment="Center" Text="80" TextChanged="ChartPhysicalSize_Changed"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Resolution:"/>
                                    <ComboBox x:Name="cmbChartResolutionDpi" Grid.Row="2" Grid.Column="1" Height="28" SelectionChanged="ChartPhysicalSize_Changed">
                                        <ComboBoxItem Content="Standard - 300 DPI" Tag="300" IsSelected="True"/>
                                        <ComboBoxItem Content="High - 600 DPI" Tag="600"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Calculated size:"/>
                                    <TextBox x:Name="txtChartCalculatedPixels" Grid.Row="2" Grid.Column="4" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" Text="1772 x 945 px"/>

                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Font: Arial (fixed)"/>
                                        <StackPanel Margin="25,0,0,0" VerticalAlignment="Center">
                                            <CheckBox x:Name="chkChartGridLines" Content="Show major gridlines" IsChecked="True"/>
                                            <CheckBox x:Name="chkChartTemperature" Margin="0,6,0,0" Content="Show temperature"/>
                                            <CheckBox x:Name="chkChartEastAsY"
                                                      Margin="0,6,0,0"
                                                      Content="dE = dY"
                                                      Visibility="Collapsed"
                                                      Checked="ChartAxisAlias_CheckedChanged"
                                                      Unchecked="ChartAxisAlias_CheckedChanged"/>
                                            <CheckBox x:Name="chkChartNorthAsX"
                                                      Margin="0,6,0,0"
                                                      Content="dN = dX"
                                                      Visibility="Collapsed"
                                                      Checked="ChartAxisAlias_CheckedChanged"
                                                      Unchecked="ChartAxisAlias_CheckedChanged"/>
                                        </StackPanel>
                                        <TextBlock Margin="25,0,8,0" VerticalAlignment="Center" Text="Line width:"/>
                                        <ComboBox x:Name="txtChartDefaultLineWidth" Width="55" Height="28" SelectedIndex="1" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="6"/>
                                        </ComboBox>
                                        <TextBlock Margin="20,0,8,0" VerticalAlignment="Center" Text="Marker size:"/>
                                        <ComboBox x:Name="txtChartDefaultMarkerSize" Width="55" Height="28" SelectedIndex="2" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="None" Tag="0"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="6"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <TextBox x:Name="txtChartPngWidth" Visibility="Collapsed" Text="1772"/>
                                    <TextBox x:Name="txtChartPngHeight" Visibility="Collapsed" Text="945"/>
                                </Grid>
                            </TabItem>

                            <!-- #endregion -->

                        </TabControl>

                        <!-- #endregion -->

                        <!-- #region CHART PREVIEW FLYOUT -->

                        <Popup x:Name="popChartPreview"
                               Grid.Row="2"
                               Placement="Absolute"
                               AllowsTransparency="True"
                               StaysOpen="True"
                               PopupAnimation="Fade">
                            <Border Padding="16" Background="WhiteSmoke" BorderBrush="DimGray" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="10"/>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="10"/>
                                         <RowDefinition Height="Auto"/>
                                         <RowDefinition Height="10"/>
                                         <RowDefinition Height="Auto"/>
                                     </Grid.RowDefinitions>
                                    <DockPanel x:Name="pnlChartPreviewDragHeader"
                                               Grid.Row="0"
                                               Background="Transparent"
                                               Cursor="SizeAll"
                                               MouseLeftButtonDown="pnlChartPreviewDragHeader_MouseLeftButtonDown"
                                               MouseMove="pnlChartPreviewDragHeader_MouseMove"
                                               MouseLeftButtonUp="pnlChartPreviewDragHeader_MouseLeftButtonUp">
                                        <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="Bold" Text="Chart Preview"/>
                                        <Button Width="70" Height="26" HorizontalAlignment="Right" Cursor="Arrow" Content="Close" Click="btnCloseChartPreview_Click"/>
                                    </DockPanel>
                                    <Border Grid.Row="2" BorderBrush="DarkGray" BorderThickness="1" Background="White">
                                        <Canvas x:Name="cnvChartPreview" Width="566.93" Height="302.36" Background="White" ClipToBounds="True"/>
                                    </Border>
                                    <TextBlock x:Name="txtChartPreviewStatus" Grid.Row="4" Foreground="DimGray"/>
                                    <GroupBox Grid.Row="6" Header="Plotted Data" Padding="8">
                                        <TextBox x:Name="txtChartPreviewData"
                                                 Width="566.93"
                                                 Height="160"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </GroupBox>
                                </Grid>
                            </Border>
                        </Popup>

                        <!-- #endregion -->

                        <TextBlock x:Name="txtChartStatus"
                                   Grid.Row="2"
                                   Margin="12,0,12,8"
                                   VerticalAlignment="Bottom"
                                   Panel.ZIndex="10"
                                   TextWrapping="Wrap"
                                   Text="Create or select a chart definition."/>
                    </Grid>
                </TabItem>

                <!-- #endregion -->

                <!-- #region TEMPORARY DATA INSERT TAB -->

                <TabItem x:Name="tabDataInsert"
                         Header="Data Insert">
                    <Grid Margin="20">
                        <StackPanel Width="420"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="0,0,0,16"
                                       Text="Temporary test-data generator. This clears all existing coordinate and dH epoch rows before inserting new data."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="btnInsertCoordinateData"
                                    Width="190"
                                    Height="35"
                                    HorizontalAlignment="Center"
                                    Content="Insert Coordinate Data"
                                    Click="btnInsertCoordinateData_Click"/>
                            <TextBlock x:Name="txtDataInsertStatus"
                                       Margin="0,12,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- #endregion -->
            </TabControl>
        </Grid>

        <!-- #endregion -->

        <!-- #region COPYRIGHT FOOTER -->

        <TextBlock x:Name="extras_tbCopyright"
                   Grid.Row="1"
                   Margin="9,0,0,4"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   TextAlignment="Left"
                   FontFamily="Century Gothic"
                   FontSize="9"
                   Foreground="DarkSlateGray"
                   Text="{Binding CopyrightText, RelativeSource={RelativeSource AncestorType=Window}}"/>

        <!-- #endregion -->
    </Grid>

    <!-- #endregion -->
</Window>
