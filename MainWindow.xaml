<Window x:Class="GNA_DLRreport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GNA_DLRreport"
        mc:Ignorable="d"
        Title="DLR Report" Height="590" Width="960"
        Background="LightGray"  FontFamily="Arial" FontSize="12" 
        ResizeMode="NoResize" Cursor="Arrow" 
        WindowStartupLocation="CenterScreen" >

        <Grid>
        <Grid>

            <TabControl>

                <TabItem Header="Tab 1">
                    <Grid>

                    </Grid>
                </TabItem>

                <TabItem Header="Housekeeping">
                    <Grid Margin="20">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ========================================================= -->
                        <!-- DATABASE CONNECTION                                      -->
                        <!-- ========================================================= -->

                        <GroupBox Grid.Row="0"
                  Header="Database Connection"
                  Padding="15">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Connection string:"/>

                                <TextBox x:Name="txtDbConnectionString"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Height="52"
                                     FontSize="10"
                                     VerticalContentAlignment="Center"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"/>

                                <Button x:Name="btnTestDbConnection"
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Height="28"
                                    Content="Test Connection"
                                    Click="btnTestDbConnection_Click"/>

                                <TextBlock x:Name="txtDbConnectionStatus"
                           Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           VerticalAlignment="Center"
                           Text=""/>

                            </Grid>

                        </GroupBox>


                        <!-- ========================================================= -->
                        <!-- DATABASE HOUSEKEEPING                                     -->
                        <!-- ========================================================= -->

                        <GroupBox Grid.Row="2"
                  Header="Database Housekeeping"
                  Padding="15">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- ================================================= -->
                                <!-- CREATE DATABASE                                   -->
                                <!-- ================================================= -->

                                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Create database:"/>

                                <Button x:Name="btnCreateDb"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="150"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    Content="Create DB"
                                    Click="btnCreateDb_Click"/>


                                <!-- ================================================= -->
                                <!-- CLEAR TABLES                                      -->
                                <!-- ================================================= -->

                                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Clear table:"/>

                                <ComboBox x:Name="cmbClearTables"
                          Grid.Row="2"
                          Grid.Column="1"
                          Height="28"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="Select table..."/>
                                    <ComboBoxItem Content="Project"/>
                                    <ComboBoxItem Content="PointName"/>
                                    <ComboBoxItem Content="Coordinates_reference"/>
                                    <ComboBoxItem Content="PrismPairs"/>
                                    <ComboBoxItem Content="HistoricDh"/>
                                    <ComboBoxItem Content="HistoricSlew"/>
                                    <ComboBoxItem Content="HistoricTop"/>
                                    <ComboBoxItem Content="HistoricCant"/>
                                    <ComboBoxItem Content="HistoricLongCant"/>
                                    <ComboBoxItem Content="HistoricTwist"/>
                                    <ComboBoxItem Content="All Tables"/>

                                </ComboBox>

                                <Button x:Name="btnClearTables"
                        Grid.Row="2"
                        Grid.Column="3"
                        Height="30"
                        Content="Clear Tables"/>


                                <!-- ================================================= -->
                                <!-- CLEAR LATEST READING                              -->
                                <!-- ================================================= -->

                                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Clear latest reading:"/>

                                <ComboBox x:Name="cmbClearLatestReading"
                          Grid.Row="4"
                          Grid.Column="1"
                          Height="28"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="Select table..."/>
                                    <ComboBoxItem Content="HistoricDh"/>
                                    <ComboBoxItem Content="HistoricSlew"/>
                                    <ComboBoxItem Content="HistoricTop"/>
                                    <ComboBoxItem Content="HistoricCant"/>
                                    <ComboBoxItem Content="HistoricLongCant"/>
                                    <ComboBoxItem Content="HistoricTwist"/>
                                    <ComboBoxItem Content="All Historic Tables"/>

                                </ComboBox>

                                <Button x:Name="btnClearLatestReading"
                        Grid.Row="4"
                        Grid.Column="3"
                        Height="30"
                        Content="Clear Latest Reading"/>

                            </Grid>

                        </GroupBox>

                    </Grid>
                </TabItem>
                <TabItem Header="Configuration">
                    <Grid>

                    </Grid>
                </TabItem>

            </TabControl>

        </Grid>

        <TextBlock x:Name="extras_tbCopyright"
                       HorizontalAlignment="Left"
                       Height="14"
                       Margin="9,436,0,0"
                       TextAlignment="Right"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Width="117"
                       FontFamily="Century Gothic"
                       FontSize="9"
                       Foreground="LightGray">  
            <Run FontFamily="Century Gothic" FontSize="9" Foreground="DarkSlateGray" Text="© 2026 GNA Software"/>
        </TextBlock>
    </Grid>
</Window>
