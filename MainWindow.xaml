<Window x:Class="GNA_DLRreport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GNA_DLRreport"
        mc:Ignorable="d"
        Title="DLR Report"
        Height="590"
        Width="960"
        Background="LightGray"
        FontFamily="Arial"
        FontSize="12"
        ResizeMode="NoResize"
        Cursor="Arrow"
        WindowStartupLocation="CenterScreen">

    <!-- #region MAIN WINDOW LAYOUT -->

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>


        <!-- #region TABBED APPLICATION AREA -->

        <Grid Grid.Row="0">

            <TabControl>


                <!-- #region REPORT GENERATION TAB -->

                <TabItem Header="Report Generation">

                    <Grid Margin="20">

                        <!-- #region REPORT GENERATION BUTTONS -->

                        <StackPanel Width="220"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- #region REPORT SCHEDULER BUTTON -->

                            <Button x:Name="btnReportScheduler"
                                    Height="35"
                                    Margin="0,0,0,12"
                                    Content="Report Scheduler"/>

                            <!-- #endregion -->


                            <!-- #region REPORT GENERATION BUTTON -->

                            <Button x:Name="btnReportGeneration"
                                    Height="35"
                                    Content="Report Generation"/>

                            <!-- #endregion -->

                        </StackPanel>

                        <!-- #endregion -->

                    </Grid>

                </TabItem>

                <!-- #endregion -->


                <!-- #region HOUSEKEEPING TAB -->

                <TabItem Header="Housekeeping">

                    <Grid Margin="20">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- #region DATABASE CONNECTION -->

                        <GroupBox Grid.Row="0"
                                  Header="Database Connection"
                                  Padding="15">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>


                                <!-- #region CONNECTION STRING -->

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Connection string:"/>

                                <TextBox x:Name="txtDbConnectionString"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Height="52"
                                         FontSize="10"
                                         VerticalContentAlignment="Center"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"/>

                                <!-- #endregion -->


                                <!-- #region TEST DATABASE CONNECTION -->

                                <Button x:Name="btnTestDbConnection"
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Height="28"
                                        Content="Test Connection"
                                        Click="btnTestDbConnection_Click"/>

                                <TextBlock x:Name="txtDbConnectionStatus"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Grid.ColumnSpan="3"
                                           VerticalAlignment="Center"
                                           Text=""/>

                                <!-- #endregion -->

                            </Grid>

                        </GroupBox>

                        <!-- #endregion -->


                        <!-- #region DATABASE HOUSEKEEPING -->

                        <GroupBox Grid.Row="2"
                                  Header="Database Housekeeping"
                                  Padding="15">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- #region CREATE DATABASE -->

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Create database:"/>

                                <Button x:Name="btnCreateDb"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="150"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        Content="Create DB"
                                        Click="btnCreateDb_Click"/>

                                <!-- #endregion -->


                                <!-- #region CLEAR TABLES -->

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Clear table:"/>

                                <ComboBox x:Name="cmbClearTables"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          Height="28"
                                          SelectedIndex="0"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="Select table..."/>

                                    <ComboBoxItem Content="Project"/>
                                    <ComboBoxItem Content="PointName"/>
                                    <ComboBoxItem Content="PrismPairs"/>

                                    <ComboBoxItem Content="CoordinatesReference"/>
                                    <ComboBoxItem Content="CoordinatesCurrent"/>
                                    <ComboBoxItem Content="CoordinatesDaily"/>

                                    <ComboBoxItem Content="DhEpochs"/>
                                    <ComboBoxItem Content="DhDaily"/>

                                    <ComboBoxItem Content="SlewEpochs"/>
                                    <ComboBoxItem Content="SlewDaily"/>

                                    <ComboBoxItem Content="TopEpochs"/>
                                    <ComboBoxItem Content="TopDaily"/>

                                    <ComboBoxItem Content="CantEpochs"/>
                                    <ComboBoxItem Content="CantDaily"/>

                                    <ComboBoxItem Content="ShortTwistEpochs"/>
                                    <ComboBoxItem Content="ShortTwistDaily"/>

                                    <ComboBoxItem Content="LongTwistEpochs"/>
                                    <ComboBoxItem Content="LongTwistDaily"/>

                                    <ComboBoxItem Content="All Tables"/>

                                </ComboBox>

                                <Button x:Name="btnClearTables"
                                        Grid.Row="2"
                                        Grid.Column="3"
                                        Height="30"
                                        Content="Clear Tables"/>

                                <!-- #endregion -->


                                <!-- #region CLEAR LATEST READING -->

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Clear latest reading:"/>

                                <ComboBox x:Name="cmbClearLatestReading"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Height="28"
                                          SelectedIndex="0"
                                          VerticalContentAlignment="Center">

                                    <ComboBoxItem Content="Select table..."/>

                                    <ComboBoxItem Content="CoordinatesDaily"/>

                                    <ComboBoxItem Content="DhEpochs"/>
                                    <ComboBoxItem Content="DhDaily"/>

                                    <ComboBoxItem Content="SlewEpochs"/>
                                    <ComboBoxItem Content="SlewDaily"/>

                                    <ComboBoxItem Content="TopEpochs"/>
                                    <ComboBoxItem Content="TopDaily"/>

                                    <ComboBoxItem Content="CantEpochs"/>
                                    <ComboBoxItem Content="CantDaily"/>

                                    <ComboBoxItem Content="ShortTwistEpochs"/>
                                    <ComboBoxItem Content="ShortTwistDaily"/>

                                    <ComboBoxItem Content="LongTwistEpochs"/>
                                    <ComboBoxItem Content="LongTwistDaily"/>

                                    <ComboBoxItem Content="All Epoch Tables"/>
                                    <ComboBoxItem Content="All Daily Tables"/>
                                    <ComboBoxItem Content="All Time-Series Tables"/>

                                </ComboBox>

                                <Button x:Name="btnClearLatestReading"
                                        Grid.Row="4"
                                        Grid.Column="3"
                                        Height="30"
                                        Content="Clear Latest Reading"/>

                                <!-- #endregion -->

                            </Grid>

                        </GroupBox>

                        <!-- #endregion -->

                    </Grid>

                </TabItem>

                <!-- #endregion -->


                <!-- #region CONFIGURATION TAB -->

                <TabItem Header="Configuration">

                    <Grid Margin="20">

                        <!-- #region CONFIGURATION TAB LAYOUT -->

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- #endregion -->


                        <!-- #region PROJECT CONFIGURATION SUMMARY -->

                        <GroupBox Grid.Row="0"
                                  Header="Project Configuration"
                                  Padding="15">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- #region ACTIVE PROJECT DISPLAY -->

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Text="Active project:"/>

                                <TextBox x:Name="txtActiveProject"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Height="28"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center"
                                         Text="No active project"/>

                                <!-- #endregion -->


                                <!-- #region MANAGE PROJECTS BUTTON -->

                                <Button x:Name="btnManageProjects"
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Width="150"
                                        Height="30"
                                        Content="Manage Projects"
                                        Click="btnManageProjects_Click"/>

                                <!-- #endregion -->

                            </Grid>

                        </GroupBox>

                        <!-- #endregion -->


                        <!-- #region PROJECT MANAGEMENT OVERLAY -->

                        <Border x:Name="brdProjectManagement"
                                Grid.Row="0"
                                Grid.RowSpan="4"
                                Margin="35"
                                Padding="20"
                                Background="WhiteSmoke"
                                BorderBrush="DarkGray"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed"
                                Panel.ZIndex="100">

                            <Grid>

                                <!-- #region PROJECT MANAGEMENT LAYOUT -->

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- #endregion -->


                                <!-- #region PROJECT MANAGEMENT HEADER -->

                                <Grid Grid.Row="0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Text="Project Management"/>

                                    <!-- #region CLOSE PROJECT MANAGEMENT -->

                                    <Button x:Name="btnCloseProjectManagement"
                                            Grid.Column="1"
                                            Width="80"
                                            Height="28"
                                            Content="Close"
                                            Click="btnCloseProjectManagement_Click"/>

                                    <!-- #endregion -->

                                </Grid>

                                <!-- #endregion -->


                                <!-- #region ADD PROJECT -->

                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="350"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="New project:"/>

                                    <TextBox x:Name="txtNewProjectName"
                                             Grid.Column="1"
                                             Height="28"
                                             MaxLength="200"
                                             VerticalContentAlignment="Center"/>

                                    <!-- #region ADD PROJECT BUTTON -->

                                    <Button x:Name="btnAddProject"
                                            Grid.Column="3"
                                            Height="30"
                                            Content="Add Project"
                                            Click="btnAddProject_Click"/>

                                    <!-- #endregion -->

                                </Grid>

                                <!-- #endregion -->


                                <!-- #region PROJECT DATAGRID -->

                                <DataGrid x:Name="dgProjects"
                                          Grid.Row="4"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserResizeRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal">

                                    <DataGrid.Columns>

                                        <!-- #region HIDDEN PROJECT ID -->

                                        <DataGridTextColumn Header="Project ID"
                                                            Binding="{Binding Project_ID}"
                                                            Visibility="Collapsed"
                                                            IsReadOnly="True"/>

                                        <!-- #endregion -->


                                        <!-- #region ACTIVE PROJECT -->

                                        <DataGridTemplateColumn Header="Active"
                                                                Width="80"
                                                                IsReadOnly="False">

                                            <DataGridTemplateColumn.CellTemplate>

                                                <DataTemplate>

                                                    <!-- #region ACTIVE PROJECT RADIO BUTTON -->

                                                    <RadioButton HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 GroupName="ActiveProject"
                                                                 IsChecked="{Binding IsActive,
                                                                                     Mode=TwoWay,
                                                                                     UpdateSourceTrigger=PropertyChanged}"
                                                                 Click="ActiveProjectRadioButton_Click">

                                                        <!-- #region DISABLE ACTIVE SELECTION FOR DELETED PROJECTS -->

                                                        <RadioButton.Style>

                                                            <Style TargetType="RadioButton">

                                                                <Setter Property="IsEnabled"
                                                                        Value="True"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding IsDeleted}"
                                                                                 Value="True">

                                                                        <Setter Property="IsEnabled"
                                                                                Value="False"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </RadioButton.Style>

                                                        <!-- #endregion -->

                                                    </RadioButton>

                                                    <!-- #endregion -->

                                                </DataTemplate>

                                            </DataGridTemplateColumn.CellTemplate>

                                        </DataGridTemplateColumn>

                                        <!-- #endregion -->


                                        <!-- #region PROJECT NAME -->

                                        <DataGridTextColumn Header="Project Name"
                                                            Width="*"
                                                            Binding="{Binding ProjectName,
                                                                              Mode=TwoWay,
                                                                              UpdateSourceTrigger=LostFocus}">

                                            <!-- #region PROJECT NAME EDIT HANDLER -->

                                            <DataGridTextColumn.EditingElementStyle>

                                                <Style TargetType="TextBox">

                                                    <!--
                                                        The binding updates ProjectName when focus leaves the cell.
                                                        The LostFocus handler then validates and persists the change.
                                                    -->

                                                    <EventSetter Event="LostFocus"
                                                                 Handler="ProjectNameTextBox_LostFocus"/>

                                                </Style>

                                            </DataGridTextColumn.EditingElementStyle>

                                            <!-- #endregion -->

                                        </DataGridTextColumn>

                                        <!-- #endregion -->


                                        <!-- #region DELETED PROJECT -->

                                        <DataGridTemplateColumn Header="Deleted"
                                                                Width="90"
                                                                IsReadOnly="False">

                                            <DataGridTemplateColumn.CellTemplate>

                                                <DataTemplate>

                                                    <!-- #region DELETED PROJECT CHECKBOX -->

                                                    <CheckBox HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsDeleted,
                                                                                  Mode=TwoWay,
                                                                                  UpdateSourceTrigger=PropertyChanged}"
                                                              Click="DeletedProjectCheckBox_Click">

                                                        <!-- #region PREVENT ACTIVE PROJECT DELETION -->

                                                        <CheckBox.Style>

                                                            <Style TargetType="CheckBox">

                                                                <Setter Property="IsEnabled"
                                                                        Value="True"/>

                                                                <Style.Triggers>

                                                                    <!--
                                                                        An active project cannot be deleted.
                                                                        Restoration remains available for deleted projects.
                                                                    -->

                                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                                 Value="True">

                                                                        <Setter Property="IsEnabled"
                                                                                Value="False"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </CheckBox.Style>

                                                        <!-- #endregion -->

                                                    </CheckBox>

                                                    <!-- #endregion -->

                                                </DataTemplate>

                                            </DataGridTemplateColumn.CellTemplate>

                                        </DataGridTemplateColumn>

                                        <!-- #endregion -->

                                    </DataGrid.Columns>

                                </DataGrid>

                                <!-- #endregion -->


                                <!-- #region PROJECT MANAGEMENT STATUS -->

                                <Grid Grid.Row="6">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="txtProjectManagementStatus"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text=""/>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Foreground="DimGray"
                                               Text="Changes are saved after validation."/>

                                </Grid>

                                <!-- #endregion -->

                            </Grid>

                        </Border>

                        <!-- #endregion -->

                    </Grid>

                </TabItem>

                <!-- #endregion -->

            </TabControl>

        </Grid>

        <!-- #endregion -->


        <!-- #region COPYRIGHT FOOTER -->

        <TextBlock x:Name="extras_tbCopyright"
                   Grid.Row="1"
                   Margin="9,0,0,4"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   TextAlignment="Left"
                   FontFamily="Century Gothic"
                   FontSize="9"
                   Foreground="DarkSlateGray">

            <Run Text="© 2026 GNA Software"/>

        </TextBlock>

        <!-- #endregion -->

    </Grid>

    <!-- #endregion -->

</Window>