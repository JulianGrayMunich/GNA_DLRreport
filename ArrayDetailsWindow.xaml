<Window x:Class="GNA_DLRreport.ArrayDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Array Details"
        Height="360"
        Width="420"
        Background="LightGray"
        FontFamily="Arial"
        FontSize="12"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- #region ARRAY DETAILS WINDOW -->

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- #region ARRAY INFORMATION -->

        <GroupBox Grid.Row="0"
                  Header="Array Details"
                  Padding="14">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           FontWeight="Bold"
                           Text="Array ID:"/>

                <TextBlock x:Name="txtArrayId"
                           Grid.Row="0"
                           Grid.Column="1"
                           TextWrapping="NoWrap"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           FontWeight="Bold"
                           Text="Array Type:"/>

                <TextBlock x:Name="txtArrayType"
                           Grid.Row="2"
                           Grid.Column="1"
                           TextWrapping="NoWrap"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           FontWeight="Bold"
                           Text="Array Name:"/>

                <TextBlock x:Name="txtArrayName"
                           Grid.Row="4"
                           Grid.Column="1"
                           TextWrapping="NoWrap"/>


                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           FontWeight="Bold"
                           Text="A:"/>

                <TextBlock x:Name="txtPointA"
                           Grid.Row="6"
                           Grid.Column="1"
                           TextWrapping="NoWrap"/>

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           FontWeight="Bold"
                           Text="B:"/>

                <TextBlock x:Name="txtPointB"
                           Grid.Row="8"
                           Grid.Column="1"
                           TextWrapping="NoWrap"/>

                <TextBlock Grid.Row="10"
                           Grid.Column="0"
                           FontWeight="Bold"
                           Text="C:"/>

                <TextBlock x:Name="txtPointC"
                           Grid.Row="10"
                           Grid.Column="1"
                           TextWrapping="NoWrap"/>

                <TextBlock Grid.Row="12"
                           Grid.Column="0"
                           FontWeight="Bold"
                           Text="D:"/>

                <TextBlock x:Name="txtPointD"
                           Grid.Row="12"
                           Grid.Column="1"
                           TextWrapping="NoWrap"/>

                <TextBlock Grid.Row="14"
                           Grid.Column="0"
                           FontWeight="Bold"
                           Text="E:"/>

                <TextBlock x:Name="txtPointE"
                           Grid.Row="14"
                           Grid.Column="1"
                           TextWrapping="NoWrap"/>

            </Grid>

        </GroupBox>

        <!-- #endregion -->


        <!-- #region DIALOG ACTIONS -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnRetainArray"
                    Grid.Column="0"
                    Height="30"
                    IsDefault="True"
                    Content="Retain"
                    Click="btnRetainArray_Click"/>

            <Button x:Name="btnDeleteArray"
                    Grid.Column="2"
                    Height="30"
                    Content="Delete Array"
                    Click="btnDeleteArray_Click"/>

        </Grid>

        <!-- #endregion -->

    </Grid>

    <!-- #endregion -->

</Window>
